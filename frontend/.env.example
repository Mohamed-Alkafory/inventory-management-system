# Development requests go through Vite's /api proxy (see vite.config.ts), so
# the API base URL is relative by default. Leave VITE_API_URL unset locally.
# For production or a non-proxied deployment, set the full API base URL:
# VITE_API_URL=https://api.example.com/api/v1
#
# Uploaded product images are served by the backend at /uploads/... (outside the
# /api/v1 prefix). In development the Vite config proxies /uploads to the same
# backend, so no extra variable is needed. When VITE_API_URL is absolute, image
# URLs are resolved against its origin.

# Optional: run the auth + product list screens against in-memory mocks.
# VITE_USE_MOCK=true

# Optional: run the categories/suppliers screens against in-memory mocks.
# VITE_USE_MOCK_API=true
