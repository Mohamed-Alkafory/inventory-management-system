# Backend base URL.
# Development: leave unset to use the Vite /api proxy (localhost:3010).
# Production: set an absolute URL that ends in /api/v1, e.g.
# VITE_API_URL=https://inventory-api.onrender.com/api/v1
# VITE_API_URL=https://api.example.com/api/v1

# Set to "true" only to run the app against the in-memory mocks (no backend).
# Production must leave this unset or set it to "false".
# VITE_USE_MOCK=false
