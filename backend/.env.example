# Copy to .env when setting up the backend: cp .env.example .env
# DATABASE_URL must match the Postgres container from the repo root (see /.env.example).
DATABASE_URL="postgresql://inventory:change_me@localhost:5432/inventory_db?schema=public"
# Optional: direct (non-pooled) URL used only by the Prisma CLI (migrate/seed).
# On Neon set this to the direct URL and keep DATABASE_URL as the pooled URL.
# DIRECT_URL="postgresql://user:password@direct-host.example.com/inventory_db?sslmode=verify-full"
PORT=3010
# Comma-separated list for production, e.g. https://app.example.com (no trailing slash).
CORS_ORIGIN=http://localhost:5173
# Production: use a random value of at least 32 characters that is not a
# placeholder (generate one with: openssl rand -base64 48).
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=15m
# Optional: serve Swagger UI in production. Off by default outside development.
# Allowed: true | false
SWAGGER_ENABLED=false
# Optional: number of trusted proxy hops in front of the API.
# Set 1 on a single-proxy host (Render, Nginx) so rate limits are per client.
# Allowed: integer >= 0 (0 = off)
TRUST_PROXY=0
# Optional database pool tuning (positive integers). The defaults bound a
# sleeping Neon compute instead of waiting forever.
# TLS: use sslmode=verify-full in the URL; sslmode=require is still treated as
# verify-full by pg-connection-string 2.x but prints a deprecation warning.
PG_POOL_MAX=5
PG_CONNECTION_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=10000
# Optional: directory for uploaded images (product images, avatars; default: ./uploads).
UPLOADS_DIR=uploads
# Optional: image storage backend.
# local (default) writes to UPLOADS_DIR and serves it at /uploads.
# cloudinary streams uploads to Cloudinary and stores its https:// URL.
# IMAGE_STORAGE=local
# Required only when IMAGE_STORAGE=cloudinary. Never commit real values.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
