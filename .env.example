# Used by docker-compose.yml (Postgres container).
POSTGRES_USER=inventory
POSTGRES_PASSWORD=change_me
POSTGRES_DB=inventory_db
POSTGRES_PORT=5432

# Published backend port (docker compose, README URLs).
BACKEND_PORT=3010

# Published frontend port (docker compose, Nginx).
FRONTEND_PORT=8080

# Optional build-time backend URL baked into the frontend image.
# Leave empty to use same-origin `/api/v1` through the Nginx proxy.
# VITE_API_URL=

# Used by the backend (Prisma). Keep in sync with the POSTGRES_* values above.
DATABASE_URL="postgresql://inventory:change_me@localhost:5432/inventory_db?schema=public"

# Backend API.
PORT=3010
# Allowed CORS origin for direct frontend requests (Vite dev server).
CORS_ORIGIN=http://localhost:5173
# Secret for signing JWT authentication tokens — replace with a strong random value!
JWT_SECRET=replace_me_with_a_long_random_string
