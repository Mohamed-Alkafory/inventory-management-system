elative="1" as="geometry"><mxPoint x="790" y="214" as="sourcePoint" /><mxPoint x="1020" y="214" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p5_p5_m9" value="GET /notifications/unread-count (Bearer)" style="html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=8.5;strokeColor=#334155;strokeWidth=1.2;endArrow=block;endSize=6;startSize=6;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p5_p5"><mxGeometry relative="1" as="geometry"><mxPoint x="1250" y="232" as="sourcePoint" /><mxPoint x="330" y="232" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p5_p5_m10" value="unreadCount(userId) → 200 {count} → bell badge" style="html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=8.5;strokeColor=#334155;strokeWidth=1.2;endArrow=block;endSize=6;startSize=6;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p5_p5"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="250" as="sourcePoint" /><mxPoint x="560" y="250" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p5_p5_note" value="Fan-out runs AFTER the main transaction commits; every method swallows errors, so a notification failure never fails the order/stock operation. Preferences and LOW_STOCK dedupe are applied before insert. Mark read / read-all / preferences are separate authenticated routes." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;fontColor=#475569;" vertex="1" parent="p5_p5"><mxGeometry x="20" y="288" width="1580" height="24" as="geometry" /></mxCell><mxCell id="p5_p6" value="&lt;b&gt;6 · Generate a report (GET /reports/*.csv)&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;rounded=1;arcSize=6;fillColor=#EFF6FF;strok