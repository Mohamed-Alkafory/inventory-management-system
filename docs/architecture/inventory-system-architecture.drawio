kgroundColor=page;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;dashed=1;" edge="1" parent="1" source="p4_order" target="p4_move"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_r12" value="PURCHASE_RECEIPT ref? · 0..1:N" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startSize=10;endSize=10;strokeColor=#7C3AED;strokeWidth=1.3;fontColor=#5B21B6;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;dashed=1;" edge="1" parent="1" source="p4_po" target="p4_move"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_r13" value="createdBy · 1:N" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=1;startArrow=ERmandOne;endArrow=ERmany;startSize=10;endSize=10;strokeColor=#7C3AED;strokeWidth=1.3;fontColor=#5B21B6;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;" edge="1" parent="1" source="p4_user" target="p4_move"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_r14" value="contains · 1:N" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=1;startArrow=ERmandOne;endArrow=ERmany;startSize=10;endSize=10;strokeColor=#7C3AED;strokeWidth=1.3;fontColor=#5B21B6;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;" edge="1" parent="1" source="p4_po" target="p4_poitem"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_r15" value="ordered as · 1:N" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=1;startArrow=ERmandOne;endArrow=ERmany;startSize=10;endSize=10;strokeColor=#7C3AED;strokeWidth=1.3;fontColor=#5B21B6;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;" edge="1" parent="1" source="p4_product" target="p4_poitem"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_r16" value="receives · 1:N" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=1;startArrow=ERmandOne;endArrow=ERmany;startSize=10;endSize=10;strokeColor=#7C3AED;strokeWidth=1.3;fontColor=#5B21B6;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;" edge="1" parent="1" source="p4_user" target="p4_notif"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_r17" value="preferences · 1:N" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=1;startArrow=ERmandOne;endArrow=ERmany;startSize=10;endSize=10;strokeColor=#7C3AED;strokeWidth=1.3;fontColor=#5B21B6;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;" edge="1" parent="1" source="p4_user" target="p4_pref"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_r18" value="actor? · 0..1:N" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startSize=10;endSize=10;strokeColor=#7C3AED;strokeWidth=1.3;fontColor=#5B21B6;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;dashed=1;" edge="1" parent="1" source="p4_user" target="p4_audit"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_r19" value="owns · 1:N" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=1;startArrow=ERmandOne;endArrow=ERmany;startSize=10;endSize=10;strokeColor=#7C3AED;strokeWidth=1.3;fontColor=#5B21B6;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;" edge="1" parent="1" source="p4_user" target="p4_refresh"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_r20" value="assignee? · 0..1:N" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startSize=10;endSize=10;strokeColor=#7C3AED;strokeWidth=1.3;fontColor=#5B21B6;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;dashed=1;" edge="1" parent="1" source="p4_user" target="p4_contact"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4_legend" value="&lt;b&gt;ER notation &amp; constraints&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;PK&lt;/b&gt; primary key · &lt;b&gt;FK&lt;/b&gt; foreign key&lt;br&gt;&lt;b&gt;UQ&lt;/b&gt; unique constraint&lt;br&gt;? = nullable&lt;br&gt;&lt;br&gt;&lt;b&gt;Solid crow’s foot&lt;/b&gt; = required relation&lt;br&gt;&lt;b&gt;Dashed crow’s foot&lt;/b&gt; = optional FK&lt;br&gt;&lt;br&gt;All PKs are UUID (uuid).&lt;br&gt;All timestamps are timestamptz(6).&lt;br&gt;Money is decimal(12,2).&lt;br&gt;&lt;br&gt;&lt;b&gt;Cascade behavior:&lt;/b&gt;&lt;br&gt;OrderItem / OrderNote / POItem → parent Cascade&lt;br&gt;Notification / Pref / RefreshToken → User Cascade&lt;br&gt;Product / Order / PO references → Restrict&lt;br&gt;AuditLog.userId / Contact.assignee → SetNull&lt;br&gt;&lt;br&gt;&lt;b&gt;No implicit M:N.&lt;/b&gt; OrderItem and&lt;br&gt;PurchaseOrderItem are explicit join entities&lt;br&gt;with payload (price, quantity, snapshots).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;arcSize=5;fillColor=#FFFFFF;strokeColor=#7C3AED;fontColor=#1E293B;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="1640" y="95" width="350" height="420" as="geometry" /></mxCell><mxCell id="p4_notes" value="&lt;b&gt;Schema observations&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• User has TWO relations to Order: createdBy (required, Restrict) and customer (optional, SetNull). A customer order sets both to the same user; a staff walk-in order leaves customerId null.&lt;br&gt;&lt;br&gt;• OrderItem snapshots productName, sku and unitPrice so historical orders survive product edits. PurchaseOrderItem does NOT snapshot; it points at the live Product.&lt;br&gt;&lt;br&gt;• StockMovement.quantityAfter is a stored running balance per movement, not derived on read.&lt;br&gt;&lt;br&gt;• NotificationPreference uses a composite PK (userId, type), so a user has at most one row per type.&lt;br&gt;&lt;br&gt;• AuditLog.userId is nullable (system actions / deleted actors) and uses SetNull, so audit rows survive user deletion (users are deactivated, not deleted).&lt;br&gt;&lt;br&gt;• Soft delete is isActive on Category, Product, Supplier, User — rows are never hard-deleted by the API.&lt;br&gt;&lt;br&gt;• RefreshToken stores only a SHA-256 hash; revokedAt supports rotation and logout.&lt;br&gt;&lt;br&gt;• No 1:1 relationship exists in the schema.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;arcSize=5;fillColor=#FFFFFF;strokeColor=#7C3AED;fontColor=#1E293B;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="1640" y="535" width="350" height="880" as="geometry" /></mxCell></root></mxGraphModel></diagram>
  <diagram id="p5" name="5 - Request and Data Flow"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p5_title" value="&lt;b&gt;Request &amp; Data Flow — sequence diagrams for implemented workflows&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#475569&quot;&gt;Paths follow the real controllers/services. “Service” is the owning domain service; “Extra” is a collaborating service. Dashed = best-effort / after commit.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=18;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="44" as="geometry" /></mxCell><mxCell id="p5_p1" value="&lt;b&gt;1 · Login &amp; authentication (POST /auth/login)&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;rounded=1;arcSize=6;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1620" height="320" as="geometry" /></mxCell><mxCell id="p5_p1_l0" value="React / Browser" style="shape=umlLifeline;perimeter=lifelinePerimeter;size=34;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p5_p1"><mxGeometry x="20" y="40" width="160" height="245" as="geometry" /></mxCell><mxCell id="p5_p1_l1" value="Nginx :80" style="shape=umlLifeline;perimeter=lifelinePerimeter;size=34;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p5_p1"><mxGeometry x="250" y="40" width="160" height="245" as="geometry" /></mxCell><mxCell id="p5_p1_l2" value="AuthController" style="shape=umlLifeline;perimeter=lifelinePerimeter;size=34;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p5_p1"><mxGeometry x="480" y="40" width="160" height="245" as="geometry" /></mxCell><mxCell id="p5_p1_l3" value="AuthService" style="shape=umlLifeline;perimeter=lifelinePerimeter;size=34;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p5_p1"><mxGeometry x="710" y="40" width="160" height="245" as="geometry" /></mxCell><mxCell id="p5_p1_l4" value="bcrypt + JwtService" style="shape=umlLifeline;perimeter=lifelinePerimeter;size=34;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p5_p1"><mxGeometry x="940" y="40" width="160" height="245" as="geometry" /></mxCell><mxCell id="p5_p1_l5" value="PrismaService" style="shape=umlLifeline;perimeter=lifelinePerimeter;size=34;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p5_p1"><mxGeometry x="1170" y="40" width="160" height="245" as="geometry" /></mxCell><mxCell id="p5_p1_l6" value="PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;size=34;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p5_p1"><mxGeometry x="1400" y="40" width="160" height="245" as="geometry" /></mxCell><mxCell id="p5_p1_m0" value="POST /auth/login {email,password} &lt;font color=&quot;#DC2626&quot;&gt;(5/min)&lt;/font&gt;" style="html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=8.5;strokeColor=#334155;strokeWidth=1.2;endArrow=block;endSize=6;startSize=6;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p5_p1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="70" as="sourcePoint" /><mxPoint x="330" y="70" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p5_p1_m1" value="proxy /api/v1/auth/login" style="html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=8.5;strokeColor=#334155;strokeWidth=1.2;endArrow=block;endSize=6;startSize=6;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p5_p1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="88" as="sourcePoint" /><mxPoint x="560" y="88" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p5_p1_m2" value="login(LoginDto)" style="html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=8.5;strokeColor=#334155;strokeWidth=1.2;endArrow=block;endSize=6;startSize=6;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p5_p1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="106" as="sourcePoint" /><mxPoint x="790" y="106" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p5_p1_m3" value="user.findUnique({email})" style="html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=8.5;strokeColor=#334155;strokeWidth=1.2;endArrow=block;endSize=6;startSize=6;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p5_p1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="124" as="sourcePoint" /><mxPoint x="1250" y="124" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p5_p1_m4" value="SELECT users" style="html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=8.5;strokeColor=#334155;strokeWidth=1.2;endArrow=block;endSize=6;startSize=6;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p5_p1"><mxGeometry relative="1" as="geometry"><mxPoint x="1250" y="142" as="sourcePoint" /><mxPoint x="1480" y="142" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p5_p1_m5" value="user | null" style="html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=8.5;strokeColor=#334155;strokeWidth=1.2;endArrow=block;endSize=6;startSize=6;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p5_p1"><mxGeometry relative="1" as="geometry"><mxPoint x="1250" y="160" as="sourcePoint" /><mxPoint x="790" y="160" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p5_p1_m6" value="bcrypt.compare(password, passwordHash)" style="html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=8.5;strokeColor=#334155;strokeWidth=1.2;endArrow=block;endSize=6;startSize=6;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p5_p1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="178" as="sourcePoint" /><mxPoint x="1020" y="178" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p5_p1_m7" value="match?" style="html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=8.5;strokeColor=#334155;strokeWidth=1.2;endArrow=block;endSize=6;startSize=6;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p5_p1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="196" as="sourcePoint" /><mxPoint x="790" y="196" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p5_p1_m8" value="refreshToken.create(sha256, 7d)" style="html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=8.5;strokeColor=#334155;strokeWidth=1.2;endArrow=block;endSize=6;startSize=6;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p5_p1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="214" as="sourcePoint" /><mxPoint x="1250" y="214" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p5_p1_m9" value="INSERT refresh_tokens" style="html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=8.5;strokeColor=#334155;strokeWidth=1.2;endArrow=block;endSize=6;startSize=6;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p5_p1"><mxGeometry relative="1" as="geometry"><mxPoint x="1250" y="232" as="sourcePoint" /><mxPoint x="1480" y="232" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p5_p1_m10" value="201/200 tokens + user · 401 invalid · 429 throttled" style="html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=8.5;strokeColor=#334155;strokeWidth=1.2;endArrow=block;endSize=6;startSize=6;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p5_p1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="250" as="sourcePoint" /><mxPoint x="100" y="250" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p5_p1_note" value="Access token 15m, refresh 7d single-use rotation. Later requests: JwtAuthGuard verifies JWT then reloads user (isActive + role) from DB; PermissionsGuard checks ROLE_PERMISSIONS. UI stores session in localStorage (prodexa.auth.v1)." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;fontColor=#475569;" vertex="1" parent="p5_p1"><mxGeometry x="20" y="288" width="1580" height="24" as="geometry" /></mxCell><mxCell id="p5_p2" value="&lt;b&gt;2 · Fetch products (GET /products · GET /catalog/products)&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;rounded=1;arcSize=6;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="40" y="422" width="1620" height="320" as="geometry" /></mxCell><mxCell id="p5_p2_l0" value="React / Browser" style="shape=umlLifeline;perimeter=lifelinePerimeter;size=34;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p5_p2"><mxGeometry x="20" y="40" width="160" height="245" as="geometry" /></mxCell><mxCell id="p5_p2_l1" value="Nginx :80" style="shape=umlLifeline;perimeter=lifelinePerimeter;size=34;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p5_p2"><mxGeometry x="250" y="40" width="160" height="245" as="geometry" /></mxCell><mxCell id="p5_p2_l2" value="ProductsController / CatalogController" style="shape=umlLifeline;perimeter=lifelinePerimeter;size=34;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p5_p2"><mxGeometry x="480" y="40" width="160" height="245" as="geometry" /></mxCell><mxCell id="p5_p2_l3" value="ProductsService / CatalogService" style="shape=umlLifeline;perimeter=lifelinePerimeter;size=34;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p5_p2"><mxGeometry x="710" y="40" width="160" height="245" as="geometry" /></mxCell><mxCell id="p5_p2_l4" value="mappers + TanStack Query" style="shape=umlLifeline;perimeter=lifelinePerimeter;size=34;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;fillColor=#DBEAFE;strokeColor=#2563