  <diagram id="p1" name="1 - Complete System Architecture"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p1_title" value="&lt;b&gt;Inventory Management System — Complete System Architecture&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#475569&quot;&gt;Verified against backend/src, frontend/src, backend/prisma/schema.prisma, Dockerfiles and docker-compose.yml · 2026-11-01&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=18;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="44" as="geometry" /></mxCell><mxCell id="p1_user" value="&lt;b&gt;User / Browser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Chrome / Edge / mobile&lt;br&gt;SPA + REST client&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fillColor=#1E3A8A;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="180" height="110" as="geometry" /></mxCell><mxCell id="p1_host" value="&lt;b style=&quot;font-size:13px&quot;&gt;Docker host — docker-compose.yml (default bridge network, no explicit networks)&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;rounded=1;arcSize=8;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#92400E;" vertex="1" parent="1"><mxGeometry x="250" y="95" width="1460" height="790" as="geometry" /></mxCell><mxCell id="p1_frontend" value="&lt;b&gt;frontend container&lt;/b&gt; · nginx:1.27-alpine · :80" style="swimlane;startSize=30;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;rounded=1;arcSize=8;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p1_host"><mxGeometry x="30" y="60" width="370" height="650" as="geometry" /></mxCell><mxCell id="p1_fe_spa" value="&lt;b&gt;React 19 SPA (Vite build)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;main.tsx → App.tsx → AppRoutes&lt;br&gt;static assets served by Nginx&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;verticalAlign=middle;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p1_frontend"><mxGeometry x="20" y="45" width="330" height="70" as="geometry" /></mxCell><mxCell id="p1_fe_route" value="&lt;b&gt;Client routing&lt;/b&gt; · react-router-dom 7&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Public · GuestRoute · ProtectedRoute&lt;br&gt;RoleRoute: CUSTOMER / STAFF / SUPPORT / ADMIN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;verticalAlign=middle;arcSize=10;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p1_frontend"><mxGeometry x="20" y="130" width="330" height="80" as="geometry" /></mxCell><mxCell id="p1_fe_auth" value="&lt;b&gt;Auth state&lt;/b&gt; · AuthProvider + TokenStorage&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;access + refresh token in localStorage&lt;br&gt;401 → single shared refresh → retry&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;verticalAlign=middle;arcSize=10;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#991B1B;" vertex="1" parent="p1_frontend"><mxGeometry x="20" y="225" width="330" height="70" as="geometry" /></mxCell><mxCell id="p1_fe_features" value="&lt;b&gt;Feature modules (frontend/src/features)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;products · categories · suppliers · inventory · orders · purchase-orders&lt;br&gt;dashboard · reports · users · audit · notifications · contact&lt;br&gt;UI areas: admin/ · staff/ · support/ · customer/ · page/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;verticalAlign=middle;arcSize=10;align=left;spacingLeft=8;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p1_frontend"><mxGeometry x="20" y="310" width="330" height="125" as="geometry" /></mxCell><mxCell id="p1_fe_api" value="&lt;b&gt;API communication layer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;api/http.ts (axios) · lib/http.ts (fetch) · api/*Api.ts&lt;br&gt;base URL /api/v1 (same-origin) or VITE_API_URL&lt;br&gt;mappers/normalizers → TanStack Query hooks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;verticalAlign=middle;arcSize=10;align=left;spacingLeft=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p1_frontend"><mxGeometry x="20" y="450" width="330" height="85" as="geometry" /></mxCell><mxCell id="p1_nginx" value="&lt;b&gt;Nginx (frontend/nginx.conf)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;serves / and /assets, SPA fallback → index.html&lt;br&gt;proxies /api/ and /uploads/ → backend:3000&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;verticalAlign=middle;arcSize=10;align=left;spacingLeft=8;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;" vertex="1" parent="p1_frontend"><mxGeometry x="20" y="550" width="330" height="75" as="geometry" /></mxCell><mxCell id="p1_backend" value="&lt;b&gt;backend container&lt;/b&gt; · NestJS 12 · node:22 · :3000" style="swimlane;startSize=30;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;rounded=1;arcSize=8;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;" vertex="1" parent="p1_host"><mxGeometry x="460" y="60" width="580" height="650" as="geometry" /></mxCell><mxCell id="p1_be_boot" value="&lt;b&gt;main.ts bootstrap&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;helmet · CORS · global prefix /api/v1 · ValidationPipe (whitelist, forbidNonWhitelisted, transform)&lt;br&gt;/api/docs (Swagger) · /uploads static · global exception filters · listen(PORT)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;verticalAlign=middle;arcSize=10;align=left;spacingLeft=8;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#064E3B;" vertex="1" parent="p1_backend"><mxGeometry x="20" y="45" width="540" height="80" as="geometry" /></mxCell><mxCell id="p1_be_guard" value="&lt;b&gt;Global guard chain&lt;/b&gt; · ThrottlerGuard → JwtAuthGuard → PermissionsGuard&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;@Public · @AnyAuthenticated · @RequirePermission · DB role re-check on every request&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;verticalAlign=middle;arcSize=10;align=left;spacingLeft=8;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#991B1B;" vertex="1" parent="p1_backend"><mxGeometry x="20" y="140" width="540" height="62" as="geometry" /></mxCell><mxCell id="p1_ctrl" value="&lt;b&gt;Controllers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;auth · users&lt;br&gt;products · categories · catalog · suppliers&lt;br&gt;stock · orders · purchase-orders&lt;br&gt;notifications · dashboard · reports&lt;br&gt;audit-logs · contact&lt;br&gt;health&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;verticalAlign=middle;arcSize=10;align=left;spacingLeft=8;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;" vertex="1" parent="p1_backend"><mxGeometry x="20" y="220" width="170" height="190" as="geometry" /></mxCell><mxCell id="p1_svc" value="&lt;b&gt;Services / business logic&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;DTO validation &amp; permission checks&lt;br&gt;Serializable transactions&lt;br&gt;stock guards + movements&lt;br&gt;audit.log()&lt;br&gt;best-effort notifications&lt;br&gt;CSV / dashboard aggregates&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;verticalAlign=middle;arcSize=10;align=left;spacingLeft=8;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;" vertex="1" parent="p1_backend"><mxGeometry x="215" y="220" width="170" height="190" as="geometry" /></mxCell><mxCell id="p1_prisma" value="&lt;b&gt;Prisma ORM 7&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PrismaService&lt;br&gt;PrismaClient +&lt;br&gt;@prisma/adapter-pg&lt;br&gt;typed queries,&lt;br&gt;transactions,&lt;br&gt;raw SQL for&lt;br&gt;aggregates&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;verticalAlign=middle;arcSize=10;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#5B21B6;" vertex="1" parent="p1_backend"><mxGeometry x="410" y="220" width="150" height="190" as="geometry" /></mxCell><mxCell id="p1_modules" value="&lt;b&gt;AppModule imports&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Prisma · Products · Categories · Catalog · Suppliers · Stock · Orders · Notifications&lt;br&gt;PurchaseOrders · Dashboard · Audit · Reports · Health · Auth · Users · Contact&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;verticalAlign=middle;arcSize=10;align=left;spacingLeft=8;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;" vertex="1" parent="p1_backend"><mxGeometry x="20" y="430" width="540" height="90" as="geometry" /></mxCell><mxCell id="p1_be_storage" value="&lt;b&gt;ImageStorageService&lt;/b&gt; · local uploads directory · product images &amp; avatars (JPEG/PNG/WebP, magic-byte check)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;served publicly at /uploads/ by the backend and proxied by Nginx&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;verticalAlign=middle;arcSize=10;align=left;spacingLeft=8;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;" vertex="1" parent="p1_backend"><mxGeometry x="20" y="535" width="540" height="55" as="geometry" /></mxCell><mxCell id="p1_db" value="&lt;b&gt;db container&lt;/b&gt; · postgres:16-alpine · :5432" style="swimlane;startSize=30;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;rounded=1;arcSize=8;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#5B21B6;" vertex="1" parent="p1_host"><mxGeometry x="1090" y="160" width="340" height="460" as="geometry" /></mxCell><mxCell id="p1_pg" value="&lt;b&gt;PostgreSQL 16&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;database: ${POSTGRES_DB}&lt;br&gt;healthcheck: pg_isready&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#5B21B6;fontSize=12;" vertex="1" parent="p1_db"><mxGeometry x="20" y="45" width="300" height="90" as="geometry" /></mxCell><mxCell id="p1_schema" value="&lt;b&gt;Prisma schema — 15 models&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Category · Product · Supplier · User · ContactMessage&lt;br&gt;Order · OrderItem · OrderNote · StockMovement&lt;br&gt;PurchaseOrder · PurchaseOrderItem&lt;br&gt;Notification · NotificationPreference&lt;br&gt;AuditLog · RefreshToken&lt;br&gt;&lt;br&gt;8 enums: UserRole, ContactStatus, OrderStatus,&lt;br&gt;PaymentMethod, StockMovementType,&lt;br&gt;PurchaseOrderStatus, NotificationType&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;verticalAlign=middle;arcSize=10;align=left;spacingLeft=8;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#5B21B6;" vertex="1" parent="p1_db"><mxGeometry x="20" y="160" width="300" height="275" as="geometry" /></mxCell><mxCell id="p1_pgdata" value="&lt;b&gt;volume: pgdata&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;/var/lib/postgresql/data&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#5B21B6;fontSize=11;" vertex="1" parent="p1_host"><mxGeometry x="1090" y="650" width="340" height="55" as="geometry" /></mxCell><mxCell id="p1_uploads" value="&lt;b&gt;volume: uploads&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;/usr/src/app/uploads&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontSize=11;" vertex="1" parent="p1_host"><mxGeometry x="740" y="722" width="300" height="55" as="geometry" /></mxCell><mxCell id="p1_ports" value="&lt;b&gt;Published host ports:&lt;/b&gt; 8080 → frontend:80 · 3010 → backend:3000 · 5432 → db:5432. Browser can only reach published ports; service names backend/db are Docker-internal DNS." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;fontColor=#92400E;" vertex="1" parent="1"><mxGeometry x="250" y="68" width="1460" height="26" as="geometry" /></mxCell><mxCell id="p1_e1" value="&lt;b&gt;EXTERNAL&lt;/b&gt; · HTTP :8080 (host)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#1E3A8A;strokeWidth=2.5;fontColor=#1E3A8A;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="p1_user" target="p1_nginx"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_e2" value="&lt;b&gt;INTERNAL&lt;/b&gt; · HTTP backend:3000 · proxy /api/v1 + /uploads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#059669;strokeWidth=2.5;fontColor=#065F46;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p1_host" source="p1_nginx" target="p1_backend"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_e3" value="&lt;b&gt;INTERNAL&lt;/b&gt; · TCP db:5432 · DATABASE_URL · Prisma pg adapter" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#7C3AED;strokeWidth=2.5;fontColor=#5B21B6;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p1_host" source="p1_backend" target="p1_pg"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_e4" value="INTERNAL · volume writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#D97706;strokeWidth=1.8;fontColor=#92400E;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;dashed=1;" edge="1" parent="p1_host" source="p1_backend" target="p1_uploads"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_e5" value="persists" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#7C3AED;strokeWidth=1.8;fontColor=#5B21B6;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;dashed=1;" edge="1" parent="p1_host" source="p1_db" target="p1_pgdata"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_leg_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="1620" height="54" as="geometry" /></mxCell><mxCell id="p1_lg0" value="" style="rounded=1;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="60" y="945" width="20" height="20" as="geometry" /></mxCell><mxCell id="p1_lt0" value="Frontend" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="86" y="942" width="120" height="26" as="geometry" /></mxCell><mxCell id="p1_lg1" value="" style="rounded=1;fillColor=#ECFDF5;strokeColor=#059669;" vertex="1" parent="1"><mxGeometry x="230" y="945" width="20" height="20" as="geometry" /></mxCell><mxCell id="p1_lt1" value="Backend" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="256" y="942" width="120" height="26" as="geometry" /></mxCell><mxCell id="p1_lg2" value="" style="rounded=1;fillColor=#F5F3FF;strokeColor=#7C3AED;" vertex="1" parent="1"><mxGeometry x="400" y="945" width="20" height="20" as="geometry" /></mxCell><mxCell id="p1_lt2" value="Database" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="426" y="942" width="120" height="26" as="geometry" /></mxCell><mxCell id="p1_lg3" value="" style="rounded=1;fillColor=#FFFBEB;strokeColor=#D97706;" vertex="1" parent="1"><mxGeometry x="570" y="945" width="20" height="20" as="geometry" /></mxCell><mxCell id="p1_lt3" value="Infrastructure" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="596" y="942" width="120" height="26" as="geometry" /></mxCell><mxCell id="p1_lg4" value="" style="rounded=1;fillColor=#1E3A8A;strokeColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="740" y="945" width="20" height="20" as="geometry" /></mxCell><mxCell id="p1_lt4" value="External actor" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="766" y="942" width="120" height="26" as="geometry" /></mxCell><mxCell id="p1_lg5" value="" style="rounded=1;fillColor=#FEF2F2;strokeColor=#DC2626;" vertex="1" parent="1"><mxGeometry x="910" y="945" width="20" height="20" as="geometry" /></mxCell><mxCell id="p1_lt5" value="Security / auth" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="936" y="942" width="120" height="26" as="geometry" /></mxCell><mxCell id="p1_lg6" value="" style="rounded=1;fillColor=#ECFDF5;strokeColor=#059669;" vertex="1" parent="1"><mxGeometry x="1080" y="945" width="20" height="20" as="geometry" /></mxCell><mxCell id="p1_lt6" value="Internal comms" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="1106" y="942" width="120" height="26" as="geometry" /></mxCell><mxCell id="p1_leg_note" value="Dashed = persistence / local file I/O. No external services are implemented." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="1250" y="942" width="360" height="26" as="geometry" /></mxCell></root></mxGraphModel></diagram>
  <diagram id="p2" name="2 - Frontend Architecture"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p2_title" value="&lt;b&gt;Frontend Architecture — React 19 + Vite + React Router 7&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#475569&quot;&gt;Active entry point is main.tsx → App.tsx. frontend/src/app/routes.tsx exists but is not mounted by main.tsx (legacy route table).&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=18;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="44" as="geometry" /></mxCell><mxCell id="p2_boot" value="&lt;b&gt;Boot &amp; providers&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;rounded=1;arcSize=8;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="330" height="560" as="geometry" /></mxCell><mxCell id="p2_main" value="&lt;b&gt;main.tsx&lt;/b&gt;&lt;br&gt;createRoot + StrictMode" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p2_boot"><mxGeometry x="20" y="42" width="290" height="55" as="geometry" /></mxCell><mxCell id="p2_app" value="&lt;b&gt;App.tsx&lt;/b&gt;&lt;br&gt;provider composition + AppRoutes + Header/Footer" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p2_boot"><mxGeometry x="20" y="112" width="290" height="65" as="geometry" /></mxCell><mxCell id="p2_qp" value="&lt;b&gt;QueryProvider&lt;/b&gt;&lt;br&gt;TanStack Query" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p2_boot"><mxGeometry x="20" y="195" width="140" height="60" as="geometry" /></mxCell><mxCell id="p2_toast" value="&lt;b&gt;ToastProvider&lt;/b&gt;&lt;br&gt;UI notifications" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p2_boot"><mxGeometry x="170" y="195" width="140" height="60" as="geometry" /></mxCell><mxCell id="p2_router" value="&lt;b&gt;BrowserRouter&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p2_boot"><mxGeometry x="20" y="270" width="290" height="50" as="geometry" /></mxCell><mxCell id="p2_auth" value="&lt;b&gt;AuthProvider&lt;/b&gt;&lt;br&gt;session + role" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p2_boot"><mxGeometry x="20" y="335" width="140" height="60" as="geometry" /></mxCell><mxCell id="p2_cart" value="&lt;b&gt;CartProvider&lt;/b&gt;&lt;br&gt;localStorage" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p2_boot"><mxGeometry x="170" y="335" width="140" height="60" as="geometry" /></mxCell><mxCell id="p2_fav" value="&lt;b&gt;FavoritesProvider&lt;/b&gt; · localStorage" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p2_boot"><mxGeometry x="20" y="410" width="290" height="50" as="geometry" /></mxCell><mxCell id="p2_shell" value="&lt;b&gt;Header + SiteFooter&lt;/b&gt;&lt;br&gt;global shell outside routes" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p2_boot"><mxGeometry x="20" y="480" width="290" height="55" as="geometry" /></mxCell><mxCell id="p2_routes" value="&lt;b&gt;Route table — App.tsx : AppRoutes&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;rounded=1;arcSize=8;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="400" y="90" width="400" height="750" as="geometry" /></mxCell><mxCell id="p2_public" value="&lt;b&gt;Public routes (no token)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;/ · /about · /contact&lt;br&gt;/products · /products/:id (public catalog)&lt;br&gt;/forbidden&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p2_routes"><mxGeometry x="20" y="42" width="360" height="115" as="geometry" /></mxCell><mxCell id="p2_guest" value="&lt;b&gt;GuestRoute&lt;/b&gt; — signed-out only&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;/login · /register → redirect signed-in users by role&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p2_routes"><mxGeometry x="20" y="175" width="360" height="70" as="geometry" /></mxCell><mxCell id="p2_protected" value="&lt;b&gt;ProtectedRoute&lt;/b&gt; — any signed-in user&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;no user → /login with return location&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p2_routes"><mxGeometry x="20" y="265" width="360" height="70" as="geometry" /></mxCell><mxCell id="p2_roles" value="&lt;b&gt;RoleRoute gates (frontend/src/routes/RoleRoute.tsx)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;CUSTOMER&lt;/b&gt; → /dashboard/*&lt;br&gt;&lt;b&gt;STAFF + ADMIN&lt;/b&gt; → /staff/*&lt;br&gt;&lt;b&gt;SUPPORT + ADMIN&lt;/b&gt; → /support/*&lt;br&gt;&lt;b&gt;ADMIN&lt;/b&gt; → /admin/*&lt;br&gt;&lt;br&gt;Wrong role → /forbidden&lt;br&gt;Signed-out → /login&lt;br&gt;&lt;br&gt;Role comes from the stored user object;&lt;br&gt;the backend re-checks permissions on every call.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;align=left;spacingLeft=10;" vertex="1" parent="p2_routes"><mxGeometry x="20" y="355" width="360" height="300" as="geometry" /></mxCell><mxCell id="p2_legacy" value="&lt;b&gt;Legacy: app/routes.tsx&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;createBrowserRouter table, not imported by main.tsx&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#64748B;dashed=1;" vertex="1" parent="p2_routes"><mxGeometry x="20" y="670" width="360" height="60" as="geometry" /></mxCell><mxCell id="p2_areas" value="&lt;b&gt;Area layouts &amp; pages&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;rounded=1;arcSize=8;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="830" y="90" width="830" height="750" as="geometry" /></mxCell><mxCell id="p2_customer" value="&lt;b&gt;CUSTOMER — CustomerLayout&lt;/b&gt; · /dashboard&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;products · products/:id · orders · orders/:id&lt;br&gt;favorites · cart · checkout · notifications&lt;br&gt;profile · settings&lt;br&gt;&lt;br&gt;Legacy top-level /cart, /checkout, /orders redirect here.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;align=left;spacingLeft=10;fillColor=#EFF6FF;" vertex="1" parent="p2_areas"><mxGeometry x="20" y="42" width="390" height="225" as="geometry" /></mxCell><mxCell id="p2_staff" value="&lt;b&gt;STAFF + ADMIN — StaffLayout&lt;/b&gt; · /staff&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;dashboard · orders · orders/new · orders/:id&lt;br&gt;inventory · purchase-orders · purchase-orders/:id&lt;br&gt;products · products/:id · notifications&lt;br&gt;profile · settings&lt;br&gt;&lt;br&gt;Old /orders/new redirects to /staff/orders/new.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;align=left;spacingLeft=10;fillColor=#EFF6FF;" vertex="1" parent="p2_areas"><mxGeometry x="430" y="42" width="380" height="225" as="geometry" /></mxCell><mxCell id="p2_support" value="&lt;b&gt;SUPPORT + ADMIN — SupportLayout&lt;/b&gt; · /support&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;dashboard · messages · messages/:id&lt;br&gt;orders · orders/:id · products · products/:id&lt;br&gt;notifications · profile · settings&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;align=left;spacingLeft=10;fillColor=#EFF6FF;" vertex="1" parent="p2_areas"><mxGeometry x="20" y="287" width="390" height="165" as="geometry" /></mxCell><mxCell id="p2_admin" value="&lt;b&gt;ADMIN — AdminLayout&lt;/b&gt; · /admin&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;dashboard · products · inventory · categories&lt;br&gt;suppliers · purchase-orders · purchase-orders/:id&lt;br&gt;orders · orders/new · orders/:id · reports&lt;br&gt;users · audit-logs · notifications&lt;br&gt;profile · settings&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;align=left;spacingLeft=10;fillColor=#EFF6FF;" vertex="1" parent="p2_areas"><mxGeometry x="430" y="287" width="380" height="245" as="geometry" /></mxCell><mxCell id="p2_shared" value="&lt;b&gt;Shared signed-in pages (outside area shells)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;/profile · /settings · /notifications — mounted once for every authenticated role.&lt;br&gt;The same components are also nested inside each area layout.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;align=left;spacingLeft=10;" vertex="1" parent="p2_areas"><mxGeometry x="20" y="545" width="790" height="95" as="geometry" /></mxCell><mxCell id="p2_pages" value="&lt;b&gt;Page composition pattern&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;admin/pages/* and staff/pages/* are thin wrappers around features/* views:&lt;br&gt;AdminProducts → page/Products/Products · AdminDashboard → features/dashboard/DashboardView&lt;br&gt;PurchaseOrders → features/purchase-orders/PurchaseOrdersList · Reports → features/reports/ReportsView&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;align=left;spacingLeft=10;" vertex="1" parent="p2_areas"><mxGeometry x="20" y="650" width="790" height="100" as="geometry" /></mxCell><mxCell id="p2_flow" value="&lt;b&gt;HTTP clients, state and response path&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;rounded=1;arcSize=8;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="1620" height="330" as="geometry" /></mxCell><mxCell id="p2_ui" value="&lt;b&gt;Pages / components&lt;/b&gt;&lt;br&gt;render, forms, tables, charts" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p2_flow"><mxGeometry x="20" y="55" width="230" height="70" as="geometry" /></mxCell><mxCell id="p2_hooks" value="&lt;b&gt;TanStack Query hooks&lt;/b&gt;&lt;br&gt;features/*/hooks.ts · cache + retries" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p2_flow"><mxGeometry x="300" y="55" width="230" height="70" as="geometry" /></mxCell><mxCell id="p2_feapi" value="&lt;b&gt;Feature API modules&lt;/b&gt;&lt;br&gt;features/*/api.ts · mappers/normalizers" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p2_flow"><mxGeometry x="580" y="55" width="260" height="70" as="geometry" /></mxCell><mxCell id="p2_http" value="&lt;b&gt;HTTP layer&lt;/b&gt;&lt;br&gt;api/http.ts (axios) · lib/http.ts (fetch)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p2_flow"><mxGeometry x="890" y="55" width="260" height="70" as="geometry" /></mxCell><mxCell id="p2_api" value="&lt;b&gt;NestJS API&lt;/b&gt;&lt;br&gt;/api/v1/* · JSON" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;" vertex="1" parent="p2_flow"><mxGeometry x="1200" y="55" width="220" height="70" as="geometry" /></mxCell><mxCell id="p2_forms" value="&lt;b&gt;Forms &amp; validation&lt;/b&gt;&lt;br&gt;react-hook-form + zod" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p2_flow"><mxGeometry x="20" y="165" width="230" height="60" as="geometry" /></mxCell><mxCell id="p2_map" value="&lt;b&gt;Response mapping&lt;/b&gt;&lt;br&gt;normalize/format → typed models" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p2_flow"><mxGeometry x="300" y="165" width="230" height="60" as="geometry" /></mxCell><mxCell id="p2_store" value="&lt;b&gt;tokenStorage&lt;/b&gt; · localStorage key prodexa.auth.v1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#991B1B;" vertex="1" parent="p2_flow"><mxGeometry x="580" y="165" width="260" height="60" as="geometry" /></mxCell><mxCell id="p2_refresh" value="&lt;b&gt;sessionRefresh.ts&lt;/b&gt;&lt;br&gt;one shared refresh promise on 401" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#991B1B;" vertex="1" parent="p2_flow"><mxGeometry x="890" y="165" width="260" height="60" as="geometry" /></mxCell><mxCell id="p2_note" value="&lt;b&gt;Two clients, one refresh path:&lt;/b&gt; api/http.ts (axios: auth + product helpers) and lib/http.ts (fetch: most feature modules, CSV blobs). Both attach Bearer, both share sessionRefresh.ts; public catalog and contact use anonymous requests. VITE_USE_MOCK=true swaps feature APIs to mock modules (development only)." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;fontColor=#475569;" vertex="1" parent="p2_flow"><mxGeometry x="20" y="250" width="1580" height="42" as="geometry" /></mxCell><mxCell id="p2_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="p2_main" target="p2_app"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e2" value="mounts &lt;b&gt;AppRoutes&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="p2_app" target="p2_routes"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e3" value="resolves element" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="p2_routes" target="p2_areas"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e4" value="query" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p2_flow" source="p2_ui" target="p2_hooks"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e5" value="call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p2_flow" source="p2_hooks" target="p2_feapi"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e6" value="request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p2_flow" source="p2_feapi" target="p2_http"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e7" value="JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p2_flow" source="p2_http" target="p2_api"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e8" value="response → normalize" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;dashed=1;" edge="1" parent="p2_flow" source="p2_api" target="p2_map"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e9" value="typed data → render" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;dashed=1;" edge="1" parent="p2_flow" source="p2_map" target="p2_ui"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e10" value="Bearer token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;dashed=1;" edge="1" parent="p2_flow" source="p2_store" target="p2_http"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2_e11" value="rotate tokens" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;dashed=1;" edge="1" parent="p2_flow" source="p2_refresh" target="p2_store"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram>
  <diagram id="p3" name="3 - Backend Architecture"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p3_title" value="&lt;b&gt;Backend Architecture — NestJS 12&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#475569&quot;&gt;Global prefix /api/v1 · AppModule imports 16 feature modules · guards are registered once as APP_GUARD&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=18;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="44" as="geometry" /></mxCell><mxCell id="p3_pipe" value="&lt;b&gt;Request ingress &amp; global request pipeline&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;rounded=1;arcSize=8;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1620" height="220" as="geometry" /></mxCell><mxCell id="p3_nginx" value="&lt;b&gt;Nginx / browser&lt;/b&gt;&lt;br&gt;HTTP request&lt;br&gt;:3000 internal" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#064E3B;" vertex="1" parent="p3_pipe"><mxGeometry x="20" y="55" width="170" height="70" as="geometry" /></mxCell><mxCell id="p3_throttle" value="&lt;b&gt;ThrottlerGuard&lt;/b&gt;&lt;br&gt;100 req / min global&lt;br&gt;login 5/min · contact 5/h" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#991B1B;" vertex="1" parent="p3_pipe"><mxGeometry x="220" y="55" width="170" height="70" as="geometry" /></mxCell><mxCell id="p3_jwt" value="&lt;b&gt;JwtAuthGuard&lt;/b&gt;&lt;br&gt;Bearer access token&lt;br&gt;loads user from DB (isActive + role)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#991B1B;" vertex="1" parent="p3_pipe"><mxGeometry x="420" y="55" width="190" height="70" as="geometry" /></mxCell><mxCell id="p3_perm" value="&lt;b&gt;PermissionsGuard&lt;/b&gt;&lt;br&gt;ROLE_PERMISSIONS matrix&lt;br&gt;fails closed with 403" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#991B1B;" vertex="1" parent="p3_pipe"><mxGeometry x="640" y="55" width="190" height="70" as="geometry" /></mxCell><mxCell id="p3_valid" value="&lt;b&gt;ValidationPipe&lt;/b&gt;&lt;br&gt;whitelist + transform&lt;br&gt;forbidNonWhitelisted" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#991B1B;" vertex="1" parent="p3_pipe"><mxGeometry x="860" y="55" width="190" height="70" as="geometry" /></mxCell><mxCell id="p3_ctrl" value="&lt;b&gt;Controller&lt;/b&gt;&lt;br&gt;route + DTO&lt;br&gt;@CurrentUser()" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#064E3B;" vertex="1" parent="p3_pipe"><mxGeometry x="1080" y="55" width="190" height="70" as="geometry" /></mxCell><mxCell id="p3_svc" value="&lt;b&gt;Service&lt;/b&gt;&lt;br&gt;business rules&lt;br&gt;transactions" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#064E3B;fillColor=#ECFDF5;" vertex="1" parent="p3_pipe"><mxGeometry x="1300" y="55" width="190" height="70" as="geometry" /></mxCell><mxCell id="p3_pipe_note" value="&lt;b&gt;Access metadata:&lt;/b&gt; @Public (catalog, login/register, contact, health) · @AnyAuthenticated (own profile/notifications) · @RequirePermission (all other routes). Handlers without metadata are denied. Global filters: AllExceptionsFilter + PrismaExceptionFilter (Prisma-specific registered last)." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;fontColor=#475569;" vertex="1" parent="p3_pipe"><mxGeometry x="20" y="145" width="1560" height="45" as="geometry" /></mxCell><mxCell id="p3_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p3_pipe" source="p3_nginx" target="p3_throttle"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p3_pipe" source="p3_throttle" target="p3_jwt"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p3_pipe" source="p3_jwt" target="p3_perm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p3_pipe" source="p3_perm" target="p3_valid"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p3_pipe" source="p3_valid" target="p3_ctrl"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p3_pipe" source="p3_ctrl" target="p3_svc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3_modules" value="&lt;b&gt;Feature modules — controller → service → dependencies (verified from constructor injection)&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;rounded=1;arcSize=8;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="1620" height="750" as="geometry" /></mxCell><mxCell id="p3_m0" value="&lt;b style=&quot;font-size:11px&quot;&gt;AuthModule&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot;&gt;/auth: login, register, refresh, logout, me, change-password, delete me, admin-only&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;AuthController&lt;/b&gt; → &lt;b&gt;AuthService&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Deps: PrismaService · JwtService · AuditService&lt;br&gt;&lt;br&gt;Access tokens 15m; refresh 7d hashed + rotated; bcrypt 10 rounds.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=8;fillColor=#F0FDF4;strokeColor=#059669;fontColor=#064E3B;" vertex="1" parent="p3_modules"><mxGeometry x="20" y="45" width="302" height="220" as="geometry" /></mxCell><mxCell id="p3_m1" value="&lt;b style=&quot;font-size:11px&quot;&gt;UsersModule&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot;&gt;/users: list, get, create, patch, delete · /users/me/avatar POST/DELETE&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;UsersController&lt;/b&gt; → &lt;b&gt;UsersService&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Deps: PrismaService · bcrypt · AuditService · ImageStorageService&lt;br&gt;&lt;br&gt;users.manage for admin routes; avatar routes @AnyAuthenticated.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=8;fillColor=#F0FDF4;strokeColor=#059669;fontColor=#064E3B;" vertex="1" parent="p3_modules"><mxGeometry x="332" y="45" width="302" height="220" as="geometry" /></mxCell><mxCell id="p3_m2" value="&lt;b style=&quot;font-size:11px&quot;&gt;ProductsModule&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot;&gt;/products: CRUD, soft delete, POST/DELETE /:id/image&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;ProductsController&lt;/b&gt; → &lt;b&gt;ProductsService&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Deps: PrismaService · AuditService · ImageStorageService&lt;br&gt;&lt;br&gt;costPrice ADMIN-only; quantity not editable here (stock service).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=8;fillColor=#F0FDF4;strokeColor=#059669;fontColor=#064E3B;" vertex="1" parent="p3_modules"><mxGeometry x="644" y="45" width="302" height="220" as="geometry" /></mxCell><mxCell id="p3_m3" value="&lt;b style=&quot;font-size:11px&quot;&gt;CategoriesModule&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot;&gt;/categories: list, get, create, patch, soft delete&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;CategoriesController&lt;/b&gt; → &lt;b&gt;CategoriesService&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Deps: PrismaService&lt;br&gt;&lt;br&gt;Unique name; delete blocked when products are linked. No audit calls.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=8;fillColor=#F0FDF4;strokeColor=#059669;fontColor=#064E3B;" vertex="1" parent="p3_modules"><mxGeometry x="956" y="45" width="302" height="220" as="geometry" /></mxCell><mxCell id="p3_m4" value="&lt;b style=&quot;font-size:11px&quot;&gt;CatalogModule&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot;&gt;/catalog/products · /catalog/products/:id · /catalog/categories&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;CatalogController&lt;/b&gt; → &lt;b&gt;CatalogService&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Deps: PrismaService&lt;br&gt;&lt;br&gt;@Public + throttled; customer-safe fields only, active rows.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=8;fillColor=#F0FDF4;strokeColor=#059669;fontColor=#064E3B;" vertex="1" parent="p3_modules"><mxGeometry x="1268" y="45" width="302" height="220" as="geometry" /></mxCell><mxCell id="p3_m5" value="&lt;b style=&quot;font-size:11px&quot;&gt;SuppliersModule&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot;&gt;/suppliers: list, get, create, patch, soft delete&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;SuppliersController&lt;/b&gt; → &lt;b&gt;SuppliersService&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Deps: PrismaService&lt;br&gt;&lt;br&gt;Soft delete; findOne returns productCount. No audit calls.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=8;fillColor=#F0FDF4;strokeColor=#059669;fontColor=#064E3B;" vertex="1" parent="p3_modules"><mxGeometry x="20" y="275" width="302" height="220" as="geometry" /></mxCell><mxCell id="p3_m6" value="&lt;b style=&quot;font-size:11px&quot;&gt;StockModule&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot;&gt;/stock/movements · /stock/adjustments · /stock/low-stock · /products/:id/movements&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;StockController + ProductMovementsController&lt;/b&gt; → &lt;b&gt;StockService&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Deps: PrismaService · ProductsService · NotificationsService · AuditService&lt;br&gt;&lt;br&gt;Guarded atomic updateMany; ADJUSTMENT movement + audit in one Serializable tx.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=8;fillColor=#F0FDF4;strokeColor=#059669;fontColor=#064E3B;" vertex="1" parent="p3_modules"><mxGeometry x="332" y="275" width="302" height="220" as="geometry" /></mxCell><mxCell id="p3_m7" value="&lt;b style=&quot;font-size:11px&quot;&gt;OrdersModule&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot;&gt;/orders CRUD/status/cancel/notes · /orders/mine CRUD/cancel&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;OrdersController&lt;/b&gt; → &lt;b&gt;OrdersService&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Deps: PrismaService · StockService · NotificationsService · AuditService&lt;br&gt;&lt;br&gt;Order + items + stock + audit in ONE Serializable tx; notifications after commit.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=8;fillColor=#F0FDF4;strokeColor=#059669;fontColor=#064E3B;" vertex="1" parent="p3_modules"><mxGeometry x="644" y="275" width="302" height="220" as="geometry" /></mxCell><mxCell id="p3_m8" value="&lt;b style=&quot;font-size:11px&quot;&gt;PurchaseOrdersModule&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot;&gt;/purchase-orders list/get/create/status/receive&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;PurchaseOrdersController&lt;/b&gt; → &lt;b&gt;PurchaseOrdersService&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Deps: PrismaService · StockService · NotificationsService · AuditService&lt;br&gt;&lt;br&gt;Receive = quantities + PURCHASE_RECEIPT + status + audit in ONE Serializable tx.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=8;fillColor=#F0FDF4;strokeColor=#059669;fontColor=#064E3B;" vertex="1" parent="p3_modules"><mxGeometry x="956" y="275" width="302" height="220" as="geometry" /></mxCell><mxCell id="p3_m9" value="&lt;b style=&quot;font-size:11px&quot;&gt;NotificationsModule&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot;&gt;/notifications list/unread-count/read/read-all/preferences GET+PUT&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;NotificationsController&lt;/b&gt; → &lt;b&gt;NotificationsService&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Deps: PrismaService&lt;br&gt;&lt;br&gt;Fan-out by role/user, preferences and LOW_STOCK dedupe; best-effort.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=8;fillColor=#F0FDF4;strokeColor=#059669;fontColor=#064E3B;" vertex="1" parent="p3_modules"><mxGeometry x="1268" y="275" width="302" height="220" as="geometry" /></mxCell><mxCell id="p3_m10" value="&lt;b style=&quot;font-size:11px&quot;&gt;DashboardModule&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot;&gt;/dashboard/summary · low-stock · sales · top-products · stock-movements&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;DashboardController&lt;/b&gt; → &lt;b&gt;DashboardService&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Deps: PrismaService&lt;br&gt;&lt;br&gt;Aggregate/count/groupBy + parameterized $queryRaw; ADMIN only.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=8;fillColor=#F0FDF4;strokeColor=#059669;fontColor=#064E3B;" vertex="1" parent="p3_modules"><mxGeometry x="20" y="505" width="302" height="220" as="geometry" /></mxCell><mxCell id="p3_m11" value="&lt;b style=&quot;font-size:11px&quot;&gt;ReportsModule&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot;&gt;/reports/inventory.csv · low-stock.csv · sales.csv · stock-movements.csv&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;ReportsController&lt;/b&gt; → &lt;b&gt;ReportsService&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Deps: PrismaService · reports/csv.ts&lt;br&gt;&lt;br&gt;text/csv attachment; ADMIN only; sales default 30 days, max 92.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=8;fillColor=#F0FDF4;strokeColor=#059669;fontColor=#064E3B;" vertex="1" parent="p3_modules"><mxGeometry x="332" y="505" width="302" height="220" as="geometry" /></mxCell><mxCell id="p3_m12" value="&lt;b style=&quot;font-size:11px&quot;&gt;AuditModule&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot;&gt;/audit-logs (read-only list)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;AuditController&lt;/b&gt; → &lt;b&gt;AuditService&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Deps: PrismaService&lt;br&gt;&lt;br&gt;log() is best-effort; strips password/hash/token/secret keys.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=8;fillColor=#F0FDF4;strokeColor=#059669;fontColor=#064E3B;" vertex="1" parent="p3_modules"><mxGeometry x="644" y="505" width="302" height="220" as="geometry" /></mxCell><mxCell id="p3_m13" value="&lt;b style=&quot;font-size:11px&quot;&gt;ContactModule&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot;&gt;/contact (public POST) · /contact-messages list/get/patch&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;ContactController + ContactMessagesController&lt;/b&gt; → &lt;b&gt;ContactService&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Deps: PrismaService · AuditService · NotificationsService&lt;br&gt;&lt;br&gt;Honeypot + 5/hour; support triage audit; notifies SUPPORT users.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=8;fillColor=#F0FDF4;strokeColor=#059669;fontColor=#064E3B;" vertex="1" parent="p3_modules"><mxGeometry x="956" y="505" width="302" height="220" as="geometry" /></mxCell><mxCell id="p3_m14" value="&lt;b style=&quot;font-size:11px&quot;&gt;HealthModule&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot;&gt;/health (public)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;HealthController&lt;/b&gt; → &lt;b&gt;PrismaService&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Deps: PrismaService.$queryRaw SELECT 1&lt;br&gt;&lt;br&gt;200 ok / 503 when DB is down; used by Docker healthcheck.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=8;fillColor=#F0FDF4;strokeColor=#059669;fontColor=#064E3B;" vertex="1" parent="p3_modules"><mxGeometry x="1268" y="505" width="302" height="220" as="geometry" /></mxCell><mxCell id="p3_cross" value="&lt;b&gt;Persistence boundary &amp; cross-cutting concerns&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;rounded=1;arcSize=8;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="1620" height="300" as="geometry" /></mxCell><mxCell id="p3_prisma" value="&lt;b&gt;PrismaService&lt;/b&gt;&lt;br&gt;PrismaClient + PrismaPg adapter&lt;br&gt;$connect on module init&lt;br&gt;uses DATABASE_URL" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#064E3B;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#5B21B6;" vertex="1" parent="p3_cross"><mxGeometry x="20" y="50" width="260" height="120" as="geometry" /></mxCell><mxCell id="p3_db" value="&lt;b&gt;PostgreSQL 16&lt;/b&gt;&lt;br&gt;db:5432 inside Compose&lt;br&gt;15 models / 8 enums" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#064E3B;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#5B21B6;" vertex="1" parent="p3_cross"><mxGeometry x="340" y="50" width="220" height="120" as="geometry" /></mxCell><mxCell id="p3_e7" value="TCP 5432" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p3_cross" source="p3_prisma" target="p3_db"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3_cross2" value="&lt;b&gt;Cross-cutting implementations&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ConfigModule + env.validation.ts (DATABASE_URL, JWT_SECRET, CORS_ORIGIN, PORT, UPLOADS_DIR)&lt;br&gt;helmet + CORS + global prefix /api/v1 in main.ts · Swagger at /api/docs&lt;br&gt;ThrottlerModule: 100 req/min; route overrides on login (5/min), customer order create (10/min), contact (5/h)&lt;br&gt;AllExceptionsFilter + PrismaExceptionFilter (P2002 → 409, etc.)&lt;br&gt;AuditService.log() writes inside caller transactions where provided; sanitizes sensitive keys&lt;br&gt;NotificationsService is fire-and-forget after commit; failures never break the main operation&lt;br&gt;ImageStorageService: local disk, magic-byte validation, 2 MB products / 1 MB avatars&lt;br&gt;DTOs: class-validator + class-transformer; global whitelist rejects unknown fields&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=11;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#064E3B;align=left;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;" vertex="1" parent="p3_cross"><mxGeometry x="600" y="50" width="1000" height="200" as="geometry" /></mxCell><mxCell id="p3_e8" value="dispatches to module service" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;dashed=1;" edge="1" parent="1" source="p3_svc" target="p3_modules"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3_e9" value="services call PrismaService" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;dashed=1;" edge="1" parent="1" source="p3_modules" target="p3_cross"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram>
  <diagram id="p4" name="4 - Database ER Diagram"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p4_title" value="&lt;b&gt;Database ER Diagram — backend/prisma/schema.prisma&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#475569&quot;&gt;15 models · 8 enums · PK/FK/UQ/indexes exactly as declared · no implicit many-to-many tables&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=18;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="44" as="geometry" /></mxCell><mxCell id="p4_g1" value="&lt;b&gt;1 · Catalog &amp; parties&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;rounded=1;arcSize=8;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#5B21B6;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="760" height="700" as="geometry" /></mxCell><mxCell id="p4_g2" value="&lt;b&gt;2 · Identity, access &amp; audit&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;rounded=1;arcSize=8;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#5B21B6;" vertex="1" parent="1"><mxGeometry x="840" y="95" width="760" height="700" as="geometry" /></mxCell><mxCell id="p4_g3" value="&lt;b&gt;3 · Sales&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;rounded=1;arcSize=8;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#5B21B6;" vertex="1" parent="1"><mxGeometry x="40" y="815" width="760" height="530" as="geometry" /></mxCell><mxCell id="p4_g4" value="&lt;b&gt;4 · Stock &amp; purchasing&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;rounded=1;arcSize=8;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#5B21B6;" vertex="1" parent="1"><mxGeometry x="840" y="815" width="760" height="760" as="geometry" /></mxCell><mxCell id="p4_g5" value="&lt;b&gt;5 · Engagement&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;rounded=1;arcSize=8;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#5B21B6;" vertex="1" parent="1"><mxGeometry x="40" y="1365" width="760" height="330" as="geometry" /></mxCell><mxCell id="p4_g6" value="&lt;b&gt;Enums (PostgreSQL enum types)&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;rounded=1;arcSize=8;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#5B21B6;fillColor=#F0FDFA;strokeColor=#0D9488;fontColor=#134E4A;" vertex="1" parent="1"><mxGeometry x="840" y="1595" width="760" height="300" as="geometry" /></mxCell><mxCell id="p4_category" value="&lt;b style=&quot;font-size:11.5px&quot;&gt;Category&lt;/b&gt; &lt;font color=&quot;#64748B&quot; style=&quot;font-size:8.5px&quot;&gt;categories&lt;/font&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;font color=&quot;#B45309&quot;&gt;PK&lt;/font&gt; id uuid&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;UQ&lt;/font&gt; name varchar(100)&lt;br&gt;description text?&lt;br&gt;isActive boolean = true&lt;br&gt;createdAt timestamptz&lt;br&gt;updatedAt timestamptz&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;products Product[]&lt;br&gt;indexes: PK, UQ(name)&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;arcSize=5;fillColor=#FFFFFF;strokeColor=#7C3AED;fontColor=#1E293B;" vertex="1" parent="p4_g1"><mxGeometry x="20" y="45" width="340" height="200" as="geometry" /></mxCell><mxCell id="p4_supplier" value="&lt;b style=&quot;font-size:11.5px&quot;&gt;Supplier&lt;/b&gt; &lt;font color=&quot;#64748B&quot; style=&quot;font-size:8.5px&quot;&gt;suppliers&lt;/font&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;font color=&quot;#B45309&quot;&gt;PK&lt;/font&gt; id uuid&lt;br&gt;companyName varchar(200)&lt;br&gt;email varchar(255)?&lt;br&gt;phone varchar(20)?&lt;br&gt;address text?&lt;br&gt;isActive boolean = true&lt;br&gt;createdAt timestamptz&lt;br&gt;updatedAt timestamptz&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;products Product[] · purchaseOrders PurchaseOrder[]&lt;br&gt;index: companyName&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;arcSize=5;fillColor=#FFFFFF;strokeColor=#7C3AED;fontColor=#1E293B;" vertex="1" parent="p4_g1"><mxGeometry x="390" y="45" width="340" height="215" as="geometry" /></mxCell><mxCell id="p4_product" value="&lt;b style=&quot;font-size:11.5px&quot;&gt;Product&lt;/b&gt; &lt;font color=&quot;#64748B&quot; style=&quot;font-size:8.5px&quot;&gt;products&lt;/font&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;font color=&quot;#B45309&quot;&gt;PK&lt;/font&gt; id uuid&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;UQ&lt;/font&gt; sku varchar(64)&lt;br&gt;name varchar(200)&lt;br&gt;description text?&lt;br&gt;imageUrl text?&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;UQ&lt;/font&gt; barcode varchar(100)?&lt;br&gt;price decimal(12,2)&lt;br&gt;costPrice decimal(12,2)?&lt;br&gt;quantity int = 0&lt;br&gt;minStock int = 0&lt;br&gt;isActive boolean = true&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;FK&lt;/font&gt; categoryId uuid → Category (Restrict)&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;FK&lt;/font&gt; supplierId uuid? → Supplier (Restrict)&lt;br&gt;createdAt timestamptz&lt;br&gt;updatedAt timestamptz&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;orderItems · stockMovements · purchaseOrderItems&lt;br&gt;indexes: categoryId, supplierId, name&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;arcSize=5;fillColor=#FFFFFF;strokeColor=#7C3AED;fontColor=#1E293B;" vertex="1" parent="p4_g1"><mxGeometry x="190" y="300" width="370" height="360" as="geometry" /></mxCell><mxCell id="p4_user" value="&lt;b style=&quot;font-size:11.5px&quot;&gt;User&lt;/b&gt; &lt;font color=&quot;#64748B&quot; style=&quot;font-size:8.5px&quot;&gt;users&lt;/font&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;font color=&quot;#B45309&quot;&gt;PK&lt;/font&gt; id uuid&lt;br&gt;name varchar(100)&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;UQ&lt;/font&gt; email varchar(255)&lt;br&gt;passwordHash varchar(255)&lt;br&gt;avatarUrl text?&lt;br&gt;role UserRole = STAFF&lt;br&gt;isActive boolean = true&lt;br&gt;createdAt timestamptz&lt;br&gt;updatedAt timestamptz&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;createdOrders Order[] (OrderCreatedBy)&lt;br&gt;customerOrders Order[] (OrderCustomer)&lt;br&gt;stockMovements · purchaseOrders · notifications&lt;br&gt;notificationPreferences · auditLogs · refreshTokens&lt;br&gt;assignedContactMessages · orderNotes&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;arcSize=5;fillColor=#FFFFFF;strokeColor=#7C3AED;fontColor=#1E293B;" vertex="1" parent="p4_g2"><mxGeometry x="20" y="45" width="340" height="360" as="geometry" /></mxCell><mxCell id="p4_refresh" value="&lt;b style=&quot;font-size:11.5px&quot;&gt;RefreshToken&lt;/b&gt; &lt;font color=&quot;#64748B&quot; style=&quot;font-size:8.5px&quot;&gt;refresh_tokens&lt;/font&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;font color=&quot;#B45309&quot;&gt;PK&lt;/font&gt; id uuid&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;FK&lt;/font&gt; userId uuid → User (Cascade)&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;UQ&lt;/font&gt; tokenHash varchar(255)&lt;br&gt;expiresAt timestamptz&lt;br&gt;revokedAt timestamptz?&lt;br&gt;createdAt timestamptz&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;indexes: userId, expiresAt&lt;br&gt;raw token never stored · SHA-256 only&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;arcSize=5;fillColor=#FFFFFF;strokeColor=#7C3AED;fontColor=#1E293B;" vertex="1" parent="p4_g2"><mxGeometry x="390" y="45" width="340" height="200" as="geometry" /></mxCell><mxCell id="p4_audit" value="&lt;b style=&quot;font-size:11.5px&quot;&gt;AuditLog&lt;/b&gt; &lt;font color=&quot;#64748B&quot; style=&quot;font-size:8.5px&quot;&gt;audit_logs&lt;/font&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;font color=&quot;#B45309&quot;&gt;PK&lt;/font&gt; id uuid&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;FK&lt;/font&gt; userId uuid? → User (SetNull)&lt;br&gt;action varchar(100)&lt;br&gt;entityType varchar(50)&lt;br&gt;entityId varchar(100)?&lt;br&gt;oldValues json?&lt;br&gt;newValues json?&lt;br&gt;createdAt timestamptz&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;indexes: [entityType,entityId], [userId,createdAt]&lt;br&gt;sensitive keys stripped before write&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;arcSize=5;fillColor=#FFFFFF;strokeColor=#7C3AED;fontColor=#1E293B;" vertex="1" parent="p4_g2"><mxGeometry x="390" y="280" width="340" height="230" as="geometry" /></mxCell><mxCell id="p4_pref" value="&lt;b style=&quot;font-size:11.5px&quot;&gt;NotificationPreference&lt;/b&gt; &lt;font color=&quot;#64748B&quot; style=&quot;font-size:8.5px&quot;&gt;notification_preferences&lt;/font&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;font color=&quot;#B45309&quot;&gt;PK/FK&lt;/font&gt; userId uuid → User (Cascade)&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;PK&lt;/font&gt; type NotificationType&lt;br&gt;enabled boolean = true&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;composite PK [userId, type]&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;arcSize=5;fillColor=#FFFFFF;strokeColor=#7C3AED;fontColor=#1E293B;" vertex="1" parent="p4_g2"><mxGeometry x="390" y="540" width="340" height="130" as="geometry" /></mxCell><mxCell id="p4_order" value="&lt;b style=&quot;font-size:11.5px&quot;&gt;Order&lt;/b&gt; &lt;font color=&quot;#64748B&quot; style=&quot;font-size:8.5px&quot;&gt;orders&lt;/font&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;font color=&quot;#B45309&quot;&gt;PK&lt;/font&gt; id uuid&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;UQ&lt;/font&gt; orderNumber varchar(30)&lt;br&gt;status OrderStatus = PENDING&lt;br&gt;customerName varchar(100)?&lt;br&gt;customerPhone varchar(20)?&lt;br&gt;notes text?&lt;br&gt;totalAmount decimal(12,2)&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;FK&lt;/font&gt; customerId uuid? → User (SetNull)&lt;br&gt;recipientName varchar(100)?&lt;br&gt;recipientPhone varchar(20)?&lt;br&gt;shippingAddress text?&lt;br&gt;shippingCity varchar(100)?&lt;br&gt;paymentMethod PaymentMethod = COD&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;FK&lt;/font&gt; createdById uuid → User (Restrict)&lt;br&gt;cancelledAt timestamptz?&lt;br&gt;createdAt timestamptz&lt;br&gt;updatedAt timestamptz&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;orderItems · stockMovements · internalNotes&lt;br&gt;indexes: [status,createdAt], createdById, [customerId,createdAt]&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;arcSize=5;fillColor=#FFFFFF;strokeColor=#7C3AED;fontColor=#1E293B;" vertex="1" parent="p4_g3"><mxGeometry x="20" y="45" width="380" height="400" as="geometry" /></mxCell><mxCell id="p4_item" value="&lt;b style=&quot;font-size:11.5px&quot;&gt;OrderItem&lt;/b&gt; &lt;font color=&quot;#64748B&quot; style=&quot;font-size:8.5px&quot;&gt;order_items&lt;/font&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;font color=&quot;#B45309&quot;&gt;PK&lt;/font&gt; id uuid&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;FK&lt;/font&gt; orderId uuid → Order (Cascade)&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;FK&lt;/font&gt; productId uuid → Product (Restrict)&lt;br&gt;productName varchar(200) snapshot&lt;br&gt;sku varchar(64) snapshot&lt;br&gt;quantity int&lt;br&gt;unitPrice decimal(12,2)&lt;br&gt;lineTotal decimal(12,2)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;UQ [orderId, productId] · index productId&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;arcSize=5;fillColor=#FFFFFF;strokeColor=#7C3AED;fontColor=#1E293B;" vertex="1" parent="p4_g3"><mxGeometry x="430" y="45" width="330" height="230" as="geometry" /></mxCell><mxCell id="p4_note" value="&lt;b style=&quot;font-size:11.5px&quot;&gt;OrderNote&lt;/b&gt; &lt;font color=&quot;#64748B&quot; style=&quot;font-size:8.5px&quot;&gt;order_notes&lt;/font&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;font color=&quot;#B45309&quot;&gt;PK&lt;/font&gt; id uuid&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;FK&lt;/font&gt; orderId uuid → Order (Cascade)&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;FK&lt;/font&gt; authorId uuid → User (Restrict)&lt;br&gt;note text&lt;br&gt;createdAt timestamptz&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;index [orderId, createdAt]&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;arcSize=5;fillColor=#FFFFFF;strokeColor=#7C3AED;fontColor=#1E293B;" vertex="1" parent="p4_g3"><mxGeometry x="430" y="315" width="330" height="180" as="geometry" /></mxCell><mxCell id="p4_move" value="&lt;b style=&quot;font-size:11.5px&quot;&gt;StockMovement&lt;/b&gt; &lt;font color=&quot;#64748B&quot; style=&quot;font-size:8.5px&quot;&gt;stock_movements&lt;/font&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;font color=&quot;#B45309&quot;&gt;PK&lt;/font&gt; id uuid&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;FK&lt;/font&gt; productId uuid → Product (Restrict)&lt;br&gt;type StockMovementType&lt;br&gt;quantityChange int (signed)&lt;br&gt;quantityAfter int&lt;br&gt;reason text?&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;FK&lt;/font&gt; orderId uuid? → Order (Restrict)&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;FK&lt;/font&gt; purchaseOrderId uuid? → PurchaseOrder (Restrict)&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;FK&lt;/font&gt; createdById uuid → User (Restrict)&lt;br&gt;createdAt timestamptz&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;indexes: [productId,createdAt], createdById, orderId, purchaseOrderId&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;arcSize=5;fillColor=#FFFFFF;strokeColor=#7C3AED;fontColor=#1E293B;" vertex="1" parent="p4_g4"><mxGeometry x="20" y="45" width="360" height="270" as="geometry" /></mxCell><mxCell id="p4_po" value="&lt;b style=&quot;font-size:11.5px&quot;&gt;PurchaseOrder&lt;/b&gt; &lt;font color=&quot;#64748B&quot; style=&quot;font-size:8.5px&quot;&gt;purchase_orders&lt;/font&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;font color=&quot;#B45309&quot;&gt;PK&lt;/font&gt; id uuid&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;UQ&lt;/font&gt; orderNumber varchar(30)&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;FK&lt;/font&gt; supplierId uuid → Supplier (Restrict)&lt;br&gt;status PurchaseOrderStatus = DRAFT&lt;br&gt;totalAmount decimal(12,2)&lt;br&gt;expectedAt timestamptz?&lt;br&gt;receivedAt timestamptz?&lt;br&gt;notes text?&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;FK&lt;/font&gt; createdById uuid → User (Restrict)&lt;br&gt;createdAt timestamptz&lt;br&gt;updatedAt timestamptz&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;items · stockMovements&lt;br&gt;indexes: supplierId, [status,createdAt], createdById&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;arcSize=5;fillColor=#FFFFFF;strokeColor=#7C3AED;fontColor=#1E293B;" vertex="1" parent="p4_g4"><mxGeometry x="400" y="45" width="340" height="350" as="geometry" /></mxCell><mxCell id="p4_poitem" value="&lt;b style=&quot;font-size:11.5px&quot;&gt;PurchaseOrderItem&lt;/b&gt; &lt;font color=&quot;#64748B&quot; style=&quot;font-size:8.5px&quot;&gt;purchase_order_items&lt;/font&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;font color=&quot;#B45309&quot;&gt;PK&lt;/font&gt; id uuid&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;FK&lt;/font&gt; purchaseOrderId uuid → PurchaseOrder (Cascade)&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;FK&lt;/font&gt; productId uuid → Product (Restrict)&lt;br&gt;quantityOrdered int&lt;br&gt;quantityReceived int = 0&lt;br&gt;unitCost decimal(12,2)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;UQ [purchaseOrderId, productId] · index productId&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;arcSize=5;fillColor=#FFFFFF;strokeColor=#7C3AED;fontColor=#1E293B;" vertex="1" parent="p4_g4"><mxGeometry x="400" y="430" width="340" height="220" as="geometry" /></mxCell><mxCell id="p4_notif" value="&lt;b style=&quot;font-size:11.5px&quot;&gt;Notification&lt;/b&gt; &lt;font color=&quot;#64748B&quot; style=&quot;font-size:8.5px&quot;&gt;notifications&lt;/font&gt;&lt;br&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;font color=&quot;#B45309&quot;&gt;PK&lt;/font&gt; id uuid&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;FK&lt;/font&gt; userId uuid → User (Cascade)&lt;br&gt;type NotificationType&lt;br&gt;title varchar(200)&lt;br&gt;message text&lt;br&gt;entityType varchar(50)?&lt;br&gt;entityId varchar(100)?&lt;br&gt;data json?&lt;br&gt;isRead boolean = false&lt;br&gt;readAt timestamptz?&lt;br&gt;createdAt timestamptz&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;index [userId, isRead, createdAt]&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;arcSize=5;fillColor=#FFFFFF;st