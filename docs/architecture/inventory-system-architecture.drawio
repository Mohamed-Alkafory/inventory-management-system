5_p6_l5" value="PrismaService" style="shape=umlLifeline;perimeter=lifelinePerimeter;size=34;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p5_p6"><mxGeometry x="1170" y="40" width="160" height="245" as="geometry" /></mxCell><mxCell id="p5_p6_l6" value="PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;size=34;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p5_p6"><mxGeometry x="1400" y="40" width="160" height="245" as="geometry" /></mxCell><mxCell id="p5_p6_m0" value="GET /reports/inventory.csv?filters (Bearer · ADMIN)" style="html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=8.5;strokeColor=#334155;strokeWidth=1.2;endArrow=block;endSize=6;startSize=6;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p5_p6"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="70" as="sourcePoint" /><mxPoint x="330" y="70" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p5_p6_m1" value="proxy /api/v1/reports/..." style="html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=8.5;strokeColor=#334155;strokeWidth=1.2;endArrow=block;endSize=6;startSize=6;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p5_p6"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="88" as="sourcePoint" /><mxPoint x="560" y="88" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p5_p6_m2" value="inventory(query) / lowStock() / sales(range) / stockMovements(query)" style="html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=8.5;strokeColor=#334155;strokeWidth=1.2;endArrow=block;endSize=6;startSize=6;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p5_p6"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="106" as="sourcePoint" /><mxPoint x="790" y="106" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p5_p6_m3" value="product.findMany / order.findMany / stockMovement.findMany" style="html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=8.5;strokeColor=#334155;strokeWidth=1.2;endArrow=block;endSize=6;startSize=6;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p5_p6"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="124" as="sourcePoint" /><mxPoint x="1250" y="124" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p5_p6_m4" value="SELECT with filters + date range" style="html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=8.5;strokeColor=#334155;strokeWidth=1.2;endArrow=block;endSize=6;startSize=6;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p5_p6"><mxGeometry relative="1" as="geometry"><mxPoint x="1250" y="142" as="sourcePoint" /><mxPoint x="1480" y="142" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p5_p6_m5" value="rows" style="html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=8.5;strokeColor=#334155;strokeWidth=1.2;endArrow=block;endSize=6;startSize=6;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p5_p6"><mxGeometry relative="1" as="geometry"><mxPoint x="1480" y="160" as="sourcePoint" /><mxPoint x="1250" y="160" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p5_p6_m6" value="rows" style="html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=8.5;strokeColor=#334155;strokeWidth=1.2;endArrow=block;endSize=6;startSize=6;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p5_p6"><mxGeometry relative="1" as="geometry"><mxPoint x="1250" y="178" as="sourcePoint" /><mxPoint x="790" y="178" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p5_p6_m7" value="toCsv(columns, rows)" style="html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=8.5;strokeColor=#334155;strokeWidth=1.2;endArrow=block;endSize=6;startSize=6;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p5_p6"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="196" as="sourcePoint" /><mxPoint x="1020" y="196" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p5_p6_m8" value="{filename, content}" style="html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=8.5;strokeColor=#334155;strokeWidth=1.2;endArrow=block;endSize=6;startSize=6;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p5_p6"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="214" as="sourcePoint" /><mxPoint x="790" y="214" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p5_p6_m9" value="200 text/csv · Content-Disposition attachment → requestBlob → download" style="html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=8.5;strokeColor=#334155;strokeWidth=1.2;endArrow=block;endSize=6;startSize=6;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;" edge="1" parent="p5_p6"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="232" as="sourcePoint" /><mxPoint x="100" y="232" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p5_p6_note" value="reports.read is ADMIN-only. sales defaults to the last 30 days and caps the range at 92 days; low-stock uses quantity &lt;= minStock; movement export reuses the movement filters. Exports are not paginated." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=9;fontColor=#475569;" vertex="1" parent="p5_p6"><mxGeometry x="20" y="288" width="1580" height="24" as="geometry" /></mxCell></root></mxGraphModel></diagram>
  <diagram id="p6" name="6 - Docker Infrastructure"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p6_title" value="&lt;b&gt;Docker Infrastructure — docker-compose.yml&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#475569&quot;&gt;3 services · no explicit networks (Compose default bridge) · 2 named volumes · Nginx runs INSIDE the frontend container&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=18;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="44" as="geometry" /></mxCell><mxCell id="p6_host" value="&lt;b&gt;Host machine (developer laptop / server)&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;rounded=1;arcSize=8;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#92400E;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1620" height="880" as="geometry" /></mxCell><mxCell id="p6_browser" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;http://localhost:8080&lt;br&gt;(host loopback)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fillColor=#1E3A8A;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontSize=12;arcSize=12;" vertex="1" parent="p6_host"><mxGeometry x="20" y="45" width="220" height="75" as="geometry" /></mxCell><mxCell id="p6_ports" value="&lt;b&gt;Published ports (compose port mappings)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;${FRONTEND_PORT:-8080} → frontend:80&lt;br&gt;${BACKEND_PORT:-3010} → backend:3000&lt;br&gt;${POSTGRES_PORT:-5432} → db:5432&lt;br&gt;Host-only access; container names are not resolvable from the host.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;arcSize=10;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#334155;" vertex="1" parent="p6_host"><mxGeometry x="270" y="45" width="1330" height="75" as="geometry" /></mxCell><mxCell id="p6_docker" value="&lt;b&gt;Docker Engine — Compose project default network&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;rounded=1;arcSize=8;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#92400E;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p6_host"><mxGeometry x="20" y="145" width="1580" height="700" as="geometry" /></mxCell><mxCell id="p6_fe" value="&lt;b&gt;frontend&lt;/b&gt; · build ./frontend · image nginx:1.27-alpine" style="swimlane;startSize=30;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;rounded=1;arcSize=8;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#92400E;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p6_docker"><mxGeometry x="20" y="45" width="390" height="500" as="geometry" /></mxCell><mxCell id="p6_nginx" value="&lt;b&gt;Nginx :80&lt;/b&gt; · listens 0.0.0.0:80&lt;br&gt;serves /usr/share/nginx/html" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;arcSize=10;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="p6_fe"><mxGeometry x="15" y="45" width="360" height="65" as="geometry" /></mxCell><mxCell id="p6_static" value="&lt;b&gt;React static bundle&lt;/b&gt; · /app/dist → html&lt;br&gt;built by node:22-bookworm-slim stage" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;arcSize=10;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="p6_fe"><mxGeometry x="15" y="125" width="360" height="60" as="geometry" /></mxCell><mxCell id="p6_nginxconf" value="&lt;b&gt;frontend/nginx.conf&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;location / → try_files … /index.html (SPA fallback)&lt;br&gt;location /assets/ → cache 1y&lt;br&gt;location /api/ → proxy_pass http://backend:3000&lt;br&gt;location /uploads/ → proxy_pass http://backend:3000&lt;br&gt;location = /healthz → 200 ok&lt;br&gt;resolver 127.0.0.11 valid=10s · server_tokens off&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;arcSize=10;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="p6_fe"><mxGeometry x="15" y="200" width="360" height="150" as="geometry" /></mxCell><mxCell id="p6_fehealth" value="&lt;b&gt;healthcheck&lt;/b&gt; · wget http://127.0.0.1/healthz&lt;br&gt;interval 10s · retries 5 · start 5s" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;arcSize=10;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="p6_fe"><mxGeometry x="15" y="365" width="360" height="55" as="geometry" /></mxCell><mxCell id="p6_fe_vol" value="&lt;b&gt;no volume&lt;/b&gt; — static image only" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;arcSize=10;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#64748B;" vertex="1" parent="p6_fe"><mxGeometry x="15" y="435" width="360" height="50" as="geometry" /></mxCell><mxCell id="p6_be" value="&lt;b&gt;backend&lt;/b&gt; · build ./backend · node:22 · :3000" style="swimlane;startSize=30;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;rounded=1;arcSize=8;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#92400E;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;" vertex="1" parent="p6_docker"><mxGeometry x="440" y="45" width="490" height="500" as="geometry" /></mxCell><mxCell id="p6_build" value="&lt;b&gt;Dockerfile multi-stage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;base: npm ci · builder: prisma generate + npm run build&lt;br&gt;production: npm ci --omit=dev + dist + prisma + prisma.config.ts&lt;br&gt;CMD: prisma migrate deploy &amp;&amp; node dist/main.js&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;arcSize=10;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="p6_be"><mxGeometry x="15" y="45" width="460" height="90" as="geometry" /></mxCell><mxCell id="p6_nest" value="&lt;b&gt;NestJS API&lt;/b&gt; · listens :3000 · global prefix /api/v1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;arcSize=10;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="p6_be"><mxGeometry x="15" y="150" width="460" height="55" as="geometry" /></mxCell><mxCell id="p6_env" value="&lt;b&gt;environment / env_file&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;env_file: ./backend/.env&lt;br&gt;PORT=3000 (compose override)&lt;br&gt;DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?schema=public&lt;br&gt;JWT_SECRET · JWT_EXPIRES_IN · CORS_ORIGIN · UPLOADS_DIR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;arcSize=10;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="p6_be"><mxGeometry x="15" y="220" width="460" height="100" as="geometry" /></mxCell><mxCell id="p6_uploads" value="&lt;b&gt;volume mount: uploads&lt;/b&gt; → /usr/src/app/uploads&lt;br&gt;product images + avatars" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;arcSize=10;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;" vertex="1" parent="p6_be"><mxGeometry x="15" y="335" width="460" height="55" as="geometry" /></mxCell><mxCell id="p6_behealth" value="&lt;b&gt;healthcheck&lt;/b&gt; · GET http://127.0.0.1:3000/api/v1/health&lt;br&gt;depends_on db: service_healthy · start 30s · retries 5" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;arcSize=10;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="p6_be"><mxGeometry x="15" y="405" width="460" height="60" as="geometry" /></mxCell><mxCell id="p6_db" value="&lt;b&gt;db&lt;/b&gt; · image postgres:16-alpine · :5432" style="swimlane;startSize=30;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;rounded=1;arcSize=8;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#92400E;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#5B21B6;" vertex="1" parent="p6_docker"><mxGeometry x="960" y="45" width="330" height="500" as="geometry" /></mxCell><mxCell id="p6_pg" value="&lt;b&gt;PostgreSQL 16&lt;/b&gt;&lt;br&gt;container name/dns: db · port 5432" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;arcSize=10;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#5B21B6;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="p6_db"><mxGeometry x="15" y="45" width="300" height="65" as="geometry" /></mxCell><mxCell id="p6_dbenv" value="&lt;b&gt;POSTGRES_USER / PASSWORD / DB&lt;/b&gt;&lt;br&gt;values from root .env&lt;br&gt;POSTGRES_PORT=5432 published" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;arcSize=10;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#5B21B6;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="p6_db"><mxGeometry x="15" y="125" width="300" height="90" as="geometry" /></mxCell><mxCell id="p6_pgdata" value="&lt;b&gt;volume: pgdata&lt;/b&gt;&lt;br&gt;/var/lib/postgresql/data&lt;br&gt;persists across recreates" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;arcSize=10;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#5B21B6;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#EDE9FE;" vertex="1" parent="p6_db"><mxGeometry x="15" y="230" width="300" height="70" as="geometry" /></mxCell><mxCell id="p6_dbhealth" value="&lt;b&gt;healthcheck&lt;/b&gt;&lt;br&gt;pg_isready -U $POSTGRES_USER -d $POSTGRES_DB&lt;br&gt;interval 5s · retries 10" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;arcSize=10;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#5B21B6;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="p6_db"><mxGeometry x="15" y="315" width="300" height="80" as="geometry" /></mxCell><mxCell id="p6_net" value="&lt;b&gt;network: default (implicit)&lt;/b&gt; — all three services join the same bridge network. DNS by service name: frontend, backend, db. Container ports are reachable directly on the network; only published ports are reachable from the host." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;fontColor=#1E3A8A;fillColor=#DBEAFE;strokeColor=#2563EB;" vertex="1" parent="p6_docker"><mxGeometry x="20" y="570" width="1540" height="55" as="geometry" /></mxCell><mxCell id="p6_note" value="&lt;b&gt;Host vs container addresses&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Browser uses http://localhost:8080 (frontend Nginx), which proxies /api/v1 and /uploads to http://backend:3000 INSIDE Docker. The backend reaches PostgreSQL at db:5432. http://localhost:3010/api/v1 and localhost:5432 are host-side debugging routes only. Direct :3010 calls are cross-origin and depend on CORS_ORIGIN in backend/.env; same-origin Nginx calls do not need CORS.&lt;br&gt;&lt;b&gt;Unverified runtime:&lt;/b&gt; this page is derived from compose + Dockerfiles + nginx.conf; the stack was not started during this investigation.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;arcSize=10;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="1620" height="90" as="geometry" /></mxCell><mxCell id="p6_e1" value="&lt;b&gt;EXTERNAL&lt;/b&gt; · HTTP localhost:8080 → :80" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#1E3A8A;strokeWidth=2.4;strokeWidth=1.5;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;fontSize=10;" edge="1" parent="p6_host" source="p6_browser" target="p6_nginx"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6_e2" value="&lt;b&gt;INTERNAL&lt;/b&gt; · http://backend:3000 · /api/ + /uploads/" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#059669;strokeWidth=2.4;strokeWidth=1.5;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;fontSize=10;" edge="1" parent="p6_docker" source="p6_nginx" target="p6_nest"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6_e3" value="&lt;b&gt;INTERNAL&lt;/b&gt; · postgresql://…@db:5432" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#7C3AED;strokeWidth=2.4;strokeWidth=1.5;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;fontSize=10;" edge="1" parent="p6_docker" source="p6_nest" target="p6_pg"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6_e4" value="writes images" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;fontSize=10;dashed=1;" edge="1" parent="p6_docker" source="p6_nest" target="p6_uploads"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6_e5" value="persists" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;fontSize=10;dashed=1;" edge="1" parent="p6_docker" source="p6_pg" target="p6_pgdata"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6_e6" value="optional direct :3010 (CORS)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;fontSize=10;dashed=1;strokeColor=#94A3B8;fontColor=#64748B;" edge="1" parent="p6_host" source="p6_browser" target="p6_nest"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6_legend" value="&lt;b&gt;Legend:&lt;/b&gt; blue = frontend / external · green = backend · purple = database · amber = infrastructure/volumes · solid = request path · dashed = storage or optional host route. No Redis, message broker, SMTP or object storage is configured." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="1620" height="38" as="geometry" /></mxCell></root></mxGraphModel></diagram>
  <diagram id="p7" name="7 - Business Workflows"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p7_title" value="&lt;b&gt;Business Workflows — implemented processes and their data dependencies&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#475569&quot;&gt;Only workflows confirmed by controllers, services and Prisma writes are shown. State transitions are enforced in services.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=18;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="44" as="geometry" /></mxCell><mxCell id="p7_map" value="&lt;b&gt;1 · Feature dependency map — who writes which records&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;rounded=1;arcSize=8;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1620" height="545" as="geometry" /></mxCell><mxCell id="p7_db" value="&lt;b&gt;PostgreSQL 16&lt;/b&gt;&lt;br&gt;15 Prisma models&lt;br&gt;single source of truth" style="shape=cylinder3;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#5B21B6;fontSize=12;" vertex="1" parent="p7_map"><mxGeometry x="650" y="415" width="320" height="120" as="geometry" /></mxCell><mxCell id="p7_identity" value="&lt;b&gt;Identity &amp; access&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Register (CUSTOMER) · admin user CRUD · roles ADMIN/STAFF/SUPPORT/CUSTOMER&lt;br&gt;JWT access + rotating refresh token · last active ADMIN guard&lt;br&gt;Writes: users, refresh_tokens, audit_logs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;arcSize=10;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;align=left;verticalAlign=top;spacingLeft=9;spacingTop=6;" vertex="1" parent="p7_map"><mxGeometry x="20" y="45" width="380" height="150" as="geometry" /></mxCell><mxCell id="p7_catalog" value="&lt;b&gt;Catalog&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Category + Supplier + Product CRUD; soft delete via isActive&lt;br&gt;Unique SKU/barcode/category name; product image upload&lt;br&gt;Writes: categories, suppliers, products, audit_logs (products)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;arcSize=10;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;align=left;verticalAlign=top;spacingLeft=9;spacingTop=6;" vertex="1" parent="p7_map"><mxGeometry x="430" y="45" width="390" height="150" as="geometry" /></mxCell><mxCell id="p7_purchasing" value="&lt;b&gt;Purchasing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Purchase order DRAFT → ORDERED → receive&lt;br&gt;Totals computed server-side; no stock until receive&lt;br&gt;Writes: purchase_orders, purchase_order_items, stock_movements, audit_logs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;arcSize=10;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;align=left;verticalAlign=top;spacingLeft=9;spacingTop=6;" vertex="1" parent="p7_map"><mxGeometry x="850" y="45" width="370" height="150" as="geometry" /></mxCell><mxCell id="p7_support" value="&lt;b&gt;Support inbox&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Public contact form · honeypot · 5/hour&lt;br&gt;SUPPORT triage: status, assignee, internal note&lt;br&gt;Writes: contact_messages, audit_logs, notifications&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;arcSize=10;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;align=left;verticalAlign=top;spacingLeft=9;spacingTop=6;" vertex="1" parent="p7_map"><mxGeometry x="1250" y="45" width="350" height="150" as="geometry" /></mxCell><mxCell id="p7_orders" value="&lt;b&gt;Orders&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Staff till POST /orders · customer POST /orders/mine&lt;br&gt;Server-side prices, total, PENDING status, ORD-xxxx&lt;br&gt;Writes: orders, order_items, stock_movements, audit_logs, notifications&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;arcSize=10;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;align=left;verticalAlign=top;spacingLeft=9;spacingTop=6;" vertex="1" parent="p7_map"><mxGeometry x="20" y="235" width="380" height="150" as="geometry" /></mxCell><mxCell id="p7_stock" value="&lt;b&gt;Stock&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Signed adjustment with reason · movement history · low-stock list&lt;br&gt;Quantity never below zero (guarded updateMany)&lt;br&gt;Writes: products.quantity, stock_movements, audit_logs, notifications&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;arcSize=10;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;align=left;verticalAlign=top;spacingLeft=9;spacingTop=6;" vertex="1" parent="p7_map"><mxGeometry x="430" y="235" width="390" height="150" as="geometry" /></mxCell><mxCell id="p7_notify" value="&lt;b&gt;Notifications&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Event fan-out to roles/users; preferences; LOW_STOCK dedupe&lt;br&gt;Best-effort after the main commit — never blocks the write&lt;br&gt;Writes: notifications, notification_preferences&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;arcSize=10;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;align=left;verticalAlign=top;spacingLeft=9;spacingTop=6;" vertex="1" parent="p7_map"><mxGeometry x="850" y="235" width="370" height="150" as="geometry" /></mxCell><mxCell id="p7_reports" value="&lt;b&gt;Dashboard &amp; reports&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;ADMIN-only aggregates and CSV exports; read-only&lt;br&gt;summary, sales/day, top products, movements in/out&lt;br&gt;Reads: products, orders, order_items, stock_movements&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;arcSize=10;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;align=left;verticalAlign=top;spacingLeft=9;spacingTop=6;" vertex="1" parent="p7_map"><mxGeometry x="1250" y="235" width="350" height="150" as="geometry" /></mxCell><mxCell id="p7_audit" value="&lt;b&gt;Audit trail&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Read-only /audit-logs; written inside the same tx where possible; sensitive keys stripped.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;arcSize=10;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#991B1B;align=left;verticalAlign=top;spacingLeft=9;spacingTop=6;" vertex="1" parent="p7_map"><mxGeometry x="1000" y="420" width="320" height="105" as="geometry" /></mxCell><mxCell id="p7_e1" value="users · refresh_tokens · audit_logs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.4;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;fontSize=9;" edge="1" parent="p7_map" source="p7_identity" target="p7_db"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7_e2" value="categories · suppliers · products" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.4;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;fontSize=9;" edge="1" parent="p7_map" source="p7_catalog" target="p7_db"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7_e3" value="orders · order_items · notes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.4;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;fontSize=9;" edge="1" parent="p7_map" source="p7_orders" target="p7_db"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7_e4" value="products.quantity · stock_movements" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.4;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;fontSize=9;" edge="1" parent="p7_map" source="p7_stock" target="p7_db"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7_e5" value="purchase_orders · items · movements" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.4;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;fontSize=9;" edge="1" parent="p7_map" source="p7_purchasing" target="p7_db"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7_e6" value="notifications · preferences" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.4;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;fontSize=9;" edge="1" parent="p7_map" source="p7_notify" target="p7_db"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7_e7" value="contact_messages · notifications" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.4;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;fontSize=9;" edge="1" parent="p7_map" source="p7_support" target="p7_db"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7_e8" value="read-only aggregates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.4;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;fontSize=9;dashed=1;" edge="1" parent="p7_map" source="p7_reports" target="p7_db"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7_e9" value="read-only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.4;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;fontSize=9;dashed=1;" edge="1" parent="p7_map" source="p7_audit" target="p7_db"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7_e10" value="reads active products" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.4;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;fontSize=9;dashed=1;strokeColor=#2563EB;" edge="1" parent="p7_map" source="p7_orders" target="p7_catalog"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7_e11" value="SALE / RETURN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.4;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;fontSize=9;dashed=1;strokeColor=#059669;" edge="1" parent="p7_map" source="p7_orders" target="p7_stock"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7_e12" value="ORDER_CREATED / CONFIRMED / CANCELLED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.4;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;fontSize=9;dashed=1;strokeColor=#D97706;" edge="1" parent="p7_map" source="p7_orders" target="p7_notify"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7_e13" value="PURCHASE_RECEIPT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.4;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;fontSize=9;dashed=1;strokeColor=#059669;" edge="1" parent="p7_map" source="p7_purchasing" target="p7_stock"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7_e14" value="LOW_STOCK" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.4;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;fontSize=9;dashed=1;strokeColor=#D97706;" edge="1" parent="p7_map" source="p7_stock" target="p7_notify"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7_e15" value="CONTACT_MESSAGE_RECEIVED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.4;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;fontSize=9;dashed=1;strokeColor=#D97706;" edge="1" parent="p7_map" source="p7_support" target="p7_notify"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7_e16" value="supplier/products" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;strokeColor=#475569;strokeWidth=1.4;fontColor=#334155;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;fontSize=9;dashed=1;strokeColor=#2563EB;" edge="1" parent="p7_map" source="p7_catalog" target="p7_purchasing"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7_rules" value="&lt;b&gt;2 · State machines &amp; enforced business rules&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;rounded=1;arcSize=8;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="40" y="655" width="1620" height="600" as="geometry" /></mxCell><mxCell id="p7_order_sm" value="&lt;b&gt;Order lifecycle (OrderStatus)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;PENDING&lt;/b&gt; ──confirm──▶ &lt;b&gt;CONFIRMED&lt;/b&gt; ──cancel──▶ &lt;b&gt;CANCELLED&lt;/b&gt;&lt;br&gt;&lt;b&gt;PENDING&lt;/b&gt; ──cancel──▶ &lt;b&gt;CANCELLED&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Staff/Admin: PATCH /orders/:id/status (CONFIRMED or CANCELLED)&lt;br&gt;• CUSTOMER: POST /orders/mine/:id/cancel — PENDING only&lt;br&gt;• SUPPORT: POST /orders/:id/cancel — PENDING only&lt;br&gt;• Any other transition or double cancel → 409&lt;br&gt;• Cancel restores each line with a RETURN movement, stamps cancelledAt,&lt;br&gt;&amp;nbsp;&amp;nbsp;writes audit — all in the same Serializable transaction.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;arcSize=10;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;align=left;verticalAlign=top;spacingLeft=9;spacingTop=6;" vertex="1" parent="p7_rules"><mxGeometry x="20" y="45" width="780" height="235" as="geometry" /></mxCell><mxCell id="p7_po_sm" value="&lt;b&gt;Purchase order lifecycle (PurchaseOrderStatus)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;DRAFT&lt;/b&gt; ──PATCH status──▶ &lt;b&gt;ORDERED&lt;/b&gt; ──receive──▶ &lt;b&gt;PARTIALLY_RECEIVED&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;└──receive all──▶ &lt;b&gt;RECEIVED&lt;/b&gt; + receivedAt&lt;br&gt;&lt;b&gt;DRAFT / ORDERED&lt;/b&gt; ──cancel──▶ &lt;b&gt;CANCELLED&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Create is always DRAFT and touches NO stock.&lt;br&gt;• Receiving accepts only ORDERED / PARTIALLY_RECEIVED.&lt;br&gt;• Over-receive, DRAFT, CANCELLED, RECEIVED → 409.&lt;br&gt;• One Serializable transaction: quantityReceived + stock + movement + status + audit.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;arcSize=10;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;align=left;verticalAlign=top;spacingLeft=9;spacingTop=6;" vertex="1" parent="p7_rules"><mxGeometry x="820" y="45" width="780" height="235" as="geometry" /></mxCell><mxCell id="p7_stock_rule" value="&lt;b&gt;Stock movement types &amp; invariants&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;SALE&lt;/b&gt; — order creation, negative change, refs orderId&lt;br&gt;&lt;b&gt;RETURN&lt;/b&gt; — order cancellation, positive change, refs orderId; allowed for inactive products&lt;br&gt;&lt;b&gt;PURCHASE_RECEIPT&lt;/b&gt; — PO receive, positive change, refs purchaseOrderId&lt;br&gt;&lt;b&gt;ADJUSTMENT&lt;/b&gt; — manual signed delta, reason required, no order/PO ref&lt;br&gt;&lt;br&gt;• All writes go through StockService.applyStockChange inside the caller’s transaction.&lt;br&gt;• Negative changes use a conditional UPDATE … WHERE quantity &amp;gt;= |delta|; zero rows → 404 / 422 / 409.&lt;br&gt;• quantityAfter is re-read in the same transaction and stored on the movement.&lt;br&gt;• Low stock = quantity &amp;lt;= minStock (raw SQL / aggregate).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;arcSize=10;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#92400E;align=left;verticalAlign=top;spacingLeft=9;spacingTop=6;" vertex="1" parent="p7_rules"><mxGeometry x="20" y="305" width="780" height="260" as="geometry" /></mxCell><mxCell id="p7_security" value="&lt;b&gt;Authorization, audit &amp; soft delete&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Permissions are centralized in auth/permissions.ts: ADMIN = all; STAFF = operations + stock/PO receive; SUPPORT = read + cancel PENDING + notes + contact inbox; CUSTOMER = own orders only.&lt;br&gt;• Fail closed: a route without @Public / @AnyAuthenticated / @RequirePermission is denied.&lt;br&gt;• JwtAuthGuard reloads the user row on every request, so role changes/deactivation apply immediately.&lt;br&gt;• Audit actions: product.*, order.created/cancelled/viewed/updated, stock.adjusted, purchase_order.received, user.updated/avatar/deactivated, contact_message.status_changed.&lt;br&gt;• Categories, Suppliers, Products, Users are deactivated (isActive=false), never hard-deleted.&lt;br&gt;• Last active ADMIN cannot be deactivated (409).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;arcSize=10;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#991B1B;align=left;verticalAlign=top;spacingLeft=9;spacingTop=6;" vertex="1" parent="p7_rules"><mxGeometry x="820" y="305" width="780" height="260" as="geometry" /></mxCell><mxCell id="p7_note" value="&lt;b&gt;Important accuracy notes:&lt;/b&gt; Category and Supplier services do not write audit entries; purchase-order create/status changes are not audited (only receive is). AuditService.log is best-effort and can fail without failing the business write when called outside a transaction. Dashboard/report figures are read-only projections, not stored aggregates.&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Docker/runtime behavior and cross-container networking were verified from configuration only, not by starting the stack.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=10;arcSize=10;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;align=left;verticalAlign=top;spacingLeft=9;spacingTop=6;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="40" y="1275" width="1620" height="70" as="geometry" /></mxCell></root></mxGraphModel></diagram>
</mxfile>